---
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Crumbs from '../components/Crumbs.astro';
import { site } from '../data/site';
import { canonicalUrl } from '../lib/urls';
import { plainText } from '../lib/text';

export type SchemaKind = 'home' | 'service' | 'contact' | 'references' | 'blog' | 'article' | 'legal' | 'project' | 'error';
export type Crumb = { name: string; href: string };
export type FaqItem = { q: string; a: string };
export type WorkMeta = {
	name: string;
	description: string;
	url: string;
	image: string;
	place?: string;
	founder?: boolean;
};

type Props = {
	title: string;
	description: string;
	path?: string;
	schema?: SchemaKind;
	breadcrumbs?: Crumb[];
	serviceName?: string;
	datePublished?: string;
	dateModified?: string;
	faqs?: FaqItem[] | readonly FaqItem[];
	noindex?: boolean;
	ogType?: 'website' | 'article';
	ogImagePath?: string;
	ogImageAlt?: string;
	work?: WorkMeta;
};

const {
	title,
	description,
	path = Astro.url.pathname,
	schema = 'legal',
	breadcrumbs = [],
	serviceName,
	datePublished,
	dateModified,
	faqs = [],
	noindex = false,
	ogImagePath = '/images/eddie.jpg',
	ogImageAlt = 'Eddie J., Gründer von 9to6',
	work,
} = Astro.props;

const ogType = Astro.props.ogType ?? (schema === 'article' ? 'article' : 'website');
const isError = schema === 'error';
const canonical = canonicalUrl(path);
const homeUrl = canonicalUrl('/');
const ogImage = new URL(ogImagePath, site.url).href;
const orgId = `${homeUrl}#organization`;
const websiteId = `${homeUrl}#website`;
const webpageId = `${canonical}#webpage`;
const robots = noindex || isError ? 'noindex, follow' : 'index, follow';
const published = datePublished ?? dateModified;
const modified = dateModified ?? datePublished;

const address = {
	'@type': 'PostalAddress',
	streetAddress: site.address.street,
	postalCode: site.address.zip,
	addressLocality: site.address.city,
	addressRegion: 'Hessen',
	addressCountry: 'DE',
};

const organization = {
	'@type': ['ProfessionalService', 'LocalBusiness'],
	'@id': orgId,
	name: site.name,
	legalName: site.person.legal,
	url: homeUrl,
	email: site.email,
	telephone: '+491754045558',
	image: new URL('/images/eddie.jpg', site.url).href,
	logo: new URL('/logos/mark.svg', site.url).href,
	description: site.description,
	foundingDate: '2019',
	areaServed: ['Frankfurt am Main', 'Rhein-Main', 'Gelnhausen', 'Main-Kinzig-Kreis', 'Hessen', 'Deutschland'],
	address,
	founder: {
		'@type': 'Person',
		'@id': `${homeUrl}#eddie`,
		name: site.person.legal,
		alternateName: site.person.public,
		jobTitle: site.person.role,
		sameAs: site.social.linkedin,
		image: new URL('/images/eddie.jpg', site.url).href,
		worksFor: { '@id': orgId },
	},
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: '+491754045558',
		email: site.email,
		contactType: 'sales',
		areaServed: 'DE',
		availableLanguage: 'German',
		url: canonicalUrl('/kontakt/'),
	},
	sameAs: [site.social.linkedin],
	knowsAbout: [
		'Webdesign',
		'Webentwicklung',
		'Conversion',
		'Core Web Vitals',
		'Relaunch',
		'Frankfurt',
		'Rhein-Main',
	],
	priceRange: '€€',
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Leistungen',
		itemListElement: [
			{
				'@type': 'Offer',
				itemOffered: {
					'@type': 'Service',
					name: 'Webdesign',
					url: canonicalUrl('/leistungen/webdesign/'),
				},
			},
			{
				'@type': 'Offer',
				itemOffered: {
					'@type': 'Service',
					name: 'Webentwicklung',
					url: canonicalUrl('/leistungen/webentwicklung/'),
				},
			},
		],
	},
};

const website = {
	'@type': 'WebSite',
	'@id': websiteId,
	url: homeUrl,
	name: site.name,
	inLanguage: 'de-DE',
	publisher: { '@id': orgId },
	description: site.description,
};

const webpageType =
	schema === 'contact'
		? 'ContactPage'
		: schema === 'blog'
			? 'Blog'
			: schema === 'references'
				? 'CollectionPage'
				: schema === 'error'
					? 'WebPage'
					: 'WebPage';

const webpage: Record<string, unknown> = {
	'@type': webpageType,
	'@id': webpageId,
	url: canonical,
	name: title,
	description,
	isPartOf: { '@id': websiteId },
	about: { '@id': orgId },
	inLanguage: 'de-DE',
	primaryImageOfPage: ogImage,
};

if (breadcrumbs.length > 0) {
	webpage.breadcrumb = { '@id': `${canonical}#breadcrumb` };
}

const crumbList =
	breadcrumbs.length > 0
		? {
				'@type': 'BreadcrumbList',
				'@id': `${canonical}#breadcrumb`,
				itemListElement: [
					{
						'@type': 'ListItem',
						position: 1,
						name: 'Startseite',
						item: homeUrl,
					},
					...breadcrumbs.map((crumb, index) => ({
						'@type': 'ListItem',
						position: index + 2,
						name: crumb.name,
						item: canonicalUrl(crumb.href),
					})),
				],
			}
		: null;

const graph: Record<string, unknown>[] = [organization, website, webpage];

if (schema === 'service') {
	const serviceId = `${canonical}#service`;
	webpage.mainEntity = { '@id': serviceId };
	graph.push({
		'@type': 'Service',
		'@id': serviceId,
		name: serviceName ?? title,
		description,
		provider: { '@id': orgId },
		areaServed: ['Frankfurt am Main', 'Rhein-Main', 'Gelnhausen', 'Hessen', 'Deutschland'],
		url: canonical,
		serviceType: serviceName ?? 'Webdesign und Webentwicklung',
		audience: {
			'@type': 'Audience',
			audienceType: 'Unternehmen in Frankfurt, Rhein-Main und Deutschland',
		},
	});
}

if (schema === 'article') {
	const articleId = `${canonical}#article`;
	webpage.mainEntity = { '@id': articleId };
	graph.push({
		'@type': 'BlogPosting',
		'@id': articleId,
		url: canonical,
		headline: title,
		description,
		datePublished: published ?? '2026-09-18',
		dateModified: modified ?? published ?? '2026-09-18',
		inLanguage: 'de-DE',
		isPartOf: { '@id': websiteId },
		image: ogImage,
		author: { '@id': `${homeUrl}#eddie` },
		publisher: { '@id': orgId },
		mainEntityOfPage: { '@id': webpageId },
	});
}

if (schema === 'project' && work) {
	const workId = `${canonical}#work`;
	webpage.mainEntity = { '@id': workId };
	graph.push({
		'@type': 'CreativeWork',
		'@id': workId,
		name: work.name,
		description: work.description,
		url: work.url,
		image: new URL(work.image, site.url).href,
		creator: { '@id': orgId },
		author: { '@id': `${homeUrl}#eddie` },
		inLanguage: 'de-DE',
		contentLocation: work.place,
		about: ['Webdesign', 'Webentwicklung'],
		isPartOf: { '@id': webpageId },
	});
}

if (faqs.length > 0) {
	const faqId = `${canonical}#faq`;
	if (!webpage.mainEntity) webpage.mainEntity = { '@id': faqId };
	graph.push({
		'@type': 'FAQPage',
		'@id': faqId,
		inLanguage: 'de-DE',
		isPartOf: { '@id': webpageId },
		mainEntity: [...faqs].map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: {
				'@type': 'Answer',
				text: plainText(item.a),
			},
		})),
	});
}

if (crumbList) graph.push(crumbList);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': graph,
};
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{isError ? null : <link rel="canonical" href={canonical} />}
		<meta name="robots" content={robots} />
		<meta name="author" content="Edvinas Jurevicius, 9to6" />
		<meta name="theme-color" content="#05050a" />
		<meta name="color-scheme" content="dark" />
		<meta name="application-name" content={site.name} />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{isError ? null : <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="1200" />
		{ogType === 'article' && published ? <meta property="article:published_time" content={published} /> : null}
		{ogType === 'article' && modified ? <meta property="article:modified_time" content={modified} /> : null}
		{ogType === 'article' ? <meta property="article:author" content={site.person.legal} /> : null}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{isError ? null : <meta name="twitter:url" content={canonical} />}
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/logos/mark.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-Kurzbeschreibung 9to6" />
		<link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM-Volltext 9to6" />
		<slot name="head" />
		{isError ? null : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<a class="skip" href="#content">Zum Inhalt wechseln</a>
		<Header />
		<main id="content">
			{breadcrumbs.length > 0 ? <Crumbs items={breadcrumbs} /> : null}
			<slot />
		</main>
		<Footer />
		<script>
			const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
			const setOpen = (open: boolean) => {
				document.body.classList.toggle('nav-open', open);
				toggle?.setAttribute('aria-expanded', String(open));
				toggle?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
			};
			toggle?.addEventListener('click', () => {
				setOpen(!document.body.classList.contains('nav-open'));
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') setOpen(false);
			});
		</script>
		<CookieBanner />
	</body>
</html>
