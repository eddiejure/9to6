---
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '../styles/global.css';
import font700 from '@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url';
import font400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Crumbs from '../components/Crumbs.astro';
import { pricing, site } from '../data/site';
import { canonicalUrl } from '../lib/urls';
import { plainText } from '../lib/text';

export type SchemaKind = 'home' | 'service' | 'contact' | 'references' | 'blog' | 'article' | 'legal' | 'project' | 'error';
export type Crumb = { name: string; href: string };
export type FaqItem = { q: string; a: string };
export type ListEntry = { name: string; url: string; description?: string };
export type WorkMeta = {
	name: string;
	description: string;
	url: string;
	image: string;
	place?: string;
	founder?: boolean;
};

type Props = {
	title: string;
	description: string;
	path?: string;
	schema?: SchemaKind;
	breadcrumbs?: Crumb[];
	serviceName?: string;
	datePublished?: string;
	dateModified?: string;
	faqs?: FaqItem[] | readonly FaqItem[];
	noindex?: boolean;
	ogType?: 'website' | 'article';
	ogImagePath?: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	work?: WorkMeta;
	itemList?: ListEntry[];
};

const {
	title,
	description,
	path = Astro.url.pathname,
	schema = 'legal',
	breadcrumbs = [],
	serviceName,
	datePublished,
	dateModified,
	faqs = [],
	noindex = false,
	ogImagePath = '/images/og-9to6.jpg',
	ogImageAlt = '9to6 – Webdesign und Webentwicklung aus Gelnhausen',
	ogImageWidth = 1200,
	ogImageHeight = 630,
	work,
	itemList = [],
} = Astro.props;

const ogType = Astro.props.ogType ?? (schema === 'article' ? 'article' : 'website');
const isError = schema === 'error';
const canonical = canonicalUrl(path);
const homeUrl = canonicalUrl('/');
const ogImage = new URL(ogImagePath, site.url).href;
const orgId = `${homeUrl}#organization`;
const websiteId = `${homeUrl}#website`;
const webpageId = `${canonical}#webpage`;
const robots = noindex || isError ? 'noindex, follow' : 'index, follow';
const published = datePublished ?? dateModified;
const modified = dateModified ?? datePublished;

const address = {
	'@type': 'PostalAddress',
	postalCode: site.address.zip,
	addressLocality: site.address.city,
	addressRegion: site.address.state,
	addressCountry: 'DE',
};

const areaServed = [
	...site.cities.map((name) => ({ '@type': 'City', name })),
	...site.regions.map((name) => ({ '@type': 'AdministrativeArea', name })),
];

const founderId = `${homeUrl}#eddie`;

const organization = {
	'@type': 'ProfessionalService',
	'@id': orgId,
	name: site.name,
	alternateName: '9to6 Webdesign',
	legalName: site.person.legal,
	slogan: site.slogan,
	url: homeUrl,
	email: site.email,
	telephone: site.phoneIntl,
	image: new URL('/images/og-9to6.jpg', site.url).href,
	logo: {
		'@type': 'ImageObject',
		url: new URL('/logos/logo-512.png', site.url).href,
		width: 512,
		height: 512,
	},
	description: site.description,
	foundingDate: site.foundingYear,
	areaServed,
	address,
	founder: {
		'@type': 'Person',
		'@id': founderId,
		name: site.person.legal,
		alternateName: site.person.public,
		jobTitle: site.person.role,
		url: canonicalUrl('/kontakt/'),
		sameAs: [site.social.linkedin],
		image: new URL('/images/eddie-og.jpg', site.url).href,
		worksFor: { '@id': orgId },
		knowsAbout: ['Webdesign', 'Webentwicklung', 'Projektleitung', 'Conversion-Optimierung', 'E-Commerce'],
	},
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: site.phoneIntl,
		email: site.email,
		contactType: 'customer service',
		areaServed: 'DE',
		availableLanguage: ['German', 'English'],
		url: canonicalUrl('/kontakt/'),
	},
	sameAs: [site.social.linkedin],
	knowsAbout: [
		'Webdesign',
		'Webentwicklung',
		'Website-Relaunch',
		'Technische SEO',
		'Lokale SEO',
		'SEO-Texte',
		'Generative Engine Optimization',
		'Conversion-Optimierung',
		'Branding und Print',
	],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Leistungen von 9to6',
		itemListElement: [
			...[
				{ name: 'Webdesign', path: '/leistungen/webdesign/' },
				{ name: 'Webentwicklung', path: '/leistungen/webentwicklung/' },
				{ name: 'SEO, Texte und KI-Sichtbarkeit', path: '/leistungen/#seo' },
			].map((item) => ({
				'@type': 'Offer',
				itemOffered: {
					'@type': 'Service',
					name: item.name,
					url: canonicalUrl(item.path),
					provider: { '@id': orgId },
				},
			})),
			{
				'@type': 'Offer',
				name: 'Website-Redesign oder neue Unternehmenswebsite',
				description: 'Üblicher Rahmen 3.000 bis 6.000 Euro, große Projekte individuell. Alternativ in monatlichen Raten, abhängig von der Laufzeit.',
				url: canonicalUrl('/preise/'),
				priceSpecification: {
					'@type': 'PriceSpecification',
					minPrice: pricing.min,
					priceCurrency: 'EUR',
				},
				itemOffered: { '@type': 'Service', name: 'Website-Relaunch', provider: { '@id': orgId } },
			},
		],
	},
};

const website = {
	'@type': 'WebSite',
	'@id': websiteId,
	url: homeUrl,
	name: site.name,
	alternateName: '9to6 Webdesign',
	inLanguage: 'de-DE',
	publisher: { '@id': orgId },
	description: site.description,
};

const webpageType =
	schema === 'contact'
		? 'ContactPage'
		: schema === 'blog'
			? 'Blog'
			: schema === 'references'
				? 'CollectionPage'
				: schema === 'error'
					? 'WebPage'
					: 'WebPage';

const webpage: Record<string, unknown> = {
	'@type': webpageType,
	'@id': webpageId,
	url: canonical,
	name: title,
	description,
	isPartOf: { '@id': websiteId },
	about: { '@id': orgId },
	inLanguage: 'de-DE',
	primaryImageOfPage: ogImage,
};

if (breadcrumbs.length > 0) {
	webpage.breadcrumb = { '@id': `${canonical}#breadcrumb` };
}

const crumbList =
	breadcrumbs.length > 0
		? {
				'@type': 'BreadcrumbList',
				'@id': `${canonical}#breadcrumb`,
				itemListElement: [
					{
						'@type': 'ListItem',
						position: 1,
						name: 'Startseite',
						item: homeUrl,
					},
					...breadcrumbs.map((crumb, index) => ({
						'@type': 'ListItem',
						position: index + 2,
						name: crumb.name,
						item: canonicalUrl(crumb.href),
					})),
				],
			}
		: null;

const graph: Record<string, unknown>[] = [organization, website, webpage];

if (schema === 'service') {
	const serviceId = `${canonical}#service`;
	webpage.mainEntity = { '@id': serviceId };
	graph.push({
		'@type': 'Service',
		'@id': serviceId,
		name: serviceName ?? title,
		description,
		provider: { '@id': orgId },
		areaServed,
		url: canonical,
		serviceType: serviceName ?? 'Webdesign und Webentwicklung',
		audience: {
			'@type': 'BusinessAudience',
			audienceType: 'Kleine und mittlere Unternehmen im Rhein-Main-Gebiet',
		},
	});
}

if (schema === 'article') {
	const articleId = `${canonical}#article`;
	webpage.mainEntity = { '@id': articleId };
	graph.push({
		'@type': 'BlogPosting',
		'@id': articleId,
		url: canonical,
		headline: title,
		description,
		datePublished: published ?? '2026-09-18',
		dateModified: modified ?? published ?? '2026-09-18',
		inLanguage: 'de-DE',
		isPartOf: { '@id': websiteId },
		image: ogImage,
		author: { '@id': founderId },
		publisher: { '@id': orgId },
		mainEntityOfPage: { '@id': webpageId },
	});
}

if (schema === 'project' && work) {
	const workId = `${canonical}#work`;
	webpage.mainEntity = { '@id': workId };
	graph.push({
		'@type': 'CreativeWork',
		'@id': workId,
		name: work.name,
		description: work.description,
		url: work.url,
		image: new URL(work.image, site.url).href,
		creator: { '@id': orgId },
		author: { '@id': founderId },
		inLanguage: 'de-DE',
		contentLocation: work.place,
		about: ['Webdesign', 'Webentwicklung'],
		isPartOf: { '@id': webpageId },
	});
}

if (itemList.length > 0) {
	const listId = `${canonical}#list`;
	if (!webpage.mainEntity) webpage.mainEntity = { '@id': listId };
	graph.push({
		'@type': 'ItemList',
		'@id': listId,
		numberOfItems: itemList.length,
		itemListElement: itemList.map((entry, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: canonicalUrl(entry.url),
			name: entry.name,
			...(entry.description ? { description: entry.description } : {}),
		})),
	});
}

if (faqs.length > 0) {
	const faqId = `${canonical}#faq`;
	if (!webpage.mainEntity) webpage.mainEntity = { '@id': faqId };
	graph.push({
		'@type': 'FAQPage',
		'@id': faqId,
		inLanguage: 'de-DE',
		isPartOf: { '@id': webpageId },
		mainEntity: [...faqs].map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: {
				'@type': 'Answer',
				text: plainText(item.a),
			},
		})),
	});
}

if (crumbList) graph.push(crumbList);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': graph,
};
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{isError ? null : <link rel="canonical" href={canonical} />}
		<meta name="robots" content={robots} />
		<meta name="author" content="Edvinas Jurevicius, 9to6" />
		<meta name="theme-color" content="#05050a" />
		<meta name="color-scheme" content="dark" />
		<meta name="application-name" content={site.name} />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{isError ? null : <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		{ogType === 'article' && published ? <meta property="article:published_time" content={published} /> : null}
		{ogType === 'article' && modified ? <meta property="article:modified_time" content={modified} /> : null}
		{ogType === 'article' ? <meta property="article:author" content={site.person.legal} /> : null}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{isError ? null : <meta name="twitter:url" content={canonical} />}
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="preload" href={font700} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-Kurzbeschreibung 9to6" />
		<link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM-Volltext 9to6" />
		<slot name="head" />
		{isError ? null : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<a class="skip" href="#content">Zum Inhalt wechseln</a>
		<Header />
		<main id="content">
			{breadcrumbs.length > 0 ? <Crumbs items={breadcrumbs} /> : null}
			<slot />
		</main>
		<Footer />
		<script>
			const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
			const setOpen = (open: boolean) => {
				document.body.classList.toggle('nav-open', open);
				toggle?.setAttribute('aria-expanded', String(open));
				toggle?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
			};
			toggle?.addEventListener('click', () => {
				setOpen(!document.body.classList.contains('nav-open'));
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') setOpen(false);
			});
			document.querySelectorAll('.mobile-panel a').forEach((link) => {
				link.addEventListener('click', () => setOpen(false));
			});
			const revealTargets =
				'.section-head, .work-card, .service-card, .feature, .step, .price-card, .quote-card, .post-card, .reason, .case-row, .roi, .invest-teaser, .cta-panel, .media-frame, .about-photo, .facts, .next-case';
			if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('reveal-on');
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							const el = entry.target;
							el.classList.add('is-in');
							observer.unobserve(el);
							// Danach aufräumen, damit Hover-Übergänge wieder greifen
							el.addEventListener(
								'transitionend',
								() => el.classList.remove('reveal', 'is-in'),
								{ once: true },
							);
						});
					},
					{ rootMargin: '0px 0px -6% 0px' },
				);
				document.querySelectorAll(revealTargets).forEach((el) => {
					if (el.closest('.hero')) return;
					el.classList.add('reveal');
					observer.observe(el);
				});
			}
			const header = document.querySelector('.site-header');
			const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
			onScroll();
			window.addEventListener('scroll', onScroll, { passive: true });
		</script>
	</body>
</html>
