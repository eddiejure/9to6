---
import { nav } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
	<div class="header-inner">
		<a class="logo" href="/" aria-label="9to6 Startseite">
			<img src="/logos/wordmark-white.svg" width="80" height="46" alt="9to6" />
		</a>
		<div class="header-right">
			<nav class="nav" aria-label="Hauptnavigation">
				{
					nav.map((item) =>
						'children' in item && item.children ? (
							<details class="nav-drop">
								<summary class:list={{ 'is-current': isCurrent(item.href) }}>
									{item.label}
									<svg class="nav-chevron" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
										<path
											d="M6 9l6 6 6-6"
											fill="none"
											stroke="currentColor"
											stroke-width="2.6"
											stroke-linecap="round"
											stroke-linejoin="round"
										></path>
									</svg>
								</summary>
								<div class="sub">
									<a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
										Alle Leistungen
									</a>
									{item.children.map((child) => (
										<a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
											{child.label}
										</a>
									))}
								</div>
							</details>
						) : (
							<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						)
					)
				}
			</nav>
			<a class="btn header-cta" href="/kontakt/">Termin wählen</a>
		</div>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menü öffnen">
			<span></span>
		</button>
	</div>
	<nav class="mobile-panel" id="mobile-menu" aria-label="Mobiles Menü">
		{
			nav.map((item) =>
				'children' in item && item.children ? (
					<details class="mobile-drop" open={isCurrent(item.href) ? true : undefined}>
						<summary>
							{item.label}
							<svg class="nav-chevron" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
								<path
									d="M6 9l6 6 6-6"
									fill="none"
									stroke="currentColor"
									stroke-width="2.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								></path>
							</svg>
						</summary>
						<div class="mobile-sub">
							<a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
								Alle Leistungen
							</a>
							{item.children.map((child) => (
								<a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
									{child.label}
								</a>
							))}
						</div>
					</details>
				) : (
					<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				)
			)
		}
		<a href="/kontakt/" aria-current={isCurrent('/kontakt/') ? 'page' : undefined}>Termin wählen</a>
	</nav>
</header>
