---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
	<div class="header-inner">
		<a class="logo" href="/" aria-label="9to6 Startseite">
			<img src="/logos/wordmark-white.svg" width="80" height="46" alt="9to6" />
		</a>
		<div class="header-right">
			<nav class="nav" aria-label="Hauptnavigation">
				{
					nav.map((item) =>
						'children' in item && item.children ? (
							<details class="nav-drop">
								<summary>{item.label}</summary>
								<div class="sub">
									<a href={item.href}>Alle Leistungen</a>
									{item.children.map((child) => (
										<a href={child.href}>{child.label}</a>
									))}
								</div>
							</details>
						) : (
							<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						)
					)
				}
			</nav>
			<a class="btn header-cta" href="/kontakt/">Angebot</a>
		</div>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menü öffnen">
			<span></span>
		</button>
	</div>
	<nav class="mobile-panel" id="mobile-menu" aria-label="Mobiles Menü">
		{
			nav.map((item) => (
				<>
					<a href={item.href}>{item.label}</a>
					{'children' in item && item.children
						? item.children.map((child) => <a href={child.href}>{child.label}</a>)
						: null}
				</>
			))
		}
		<a href="/kontakt/">Angebot anfragen</a>
		<a href={site.phoneHref}>{site.phoneDisplay}</a>
	</nav>
</header>
