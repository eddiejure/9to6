---
type Props = {
	variant?: 'compact' | 'full';
	heading?: string;
};

const { variant = 'full', heading = 'Was können wir für dich tun?' } = Astro.props;
const isCompact = variant === 'compact';
---

<form class:list={['form', isCompact && 'form-compact']} data-kontakt-form data-variant={variant} novalidate>
	{!isCompact && heading ? <h2 class="form-heading">{heading}</h2> : null}

	<label>
		<span class="sr-only">Website (leer lassen)</span>
		<input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" />
	</label>
	<input type="hidden" name="started" value="" data-started />

	{
		isCompact ? (
			<>
				<label>
					<span class="sr-only">Name</span>
					<input id="compact-name" type="text" name="name" autocomplete="name" required placeholder="Name" aria-describedby="compact-name-error" />
				</label>
				<p class="field-error" id="compact-name-error" data-error-for="name" hidden></p>
				<label>
					<span class="sr-only">Telefonnummer</span>
					<input id="compact-phone" type="tel" name="phone" autocomplete="tel" required placeholder="Telefonnummer" aria-describedby="compact-phone-error" />
				</label>
				<p class="field-error" id="compact-phone-error" data-error-for="phone" hidden></p>
			</>
		) : (
			<>
				<label for="full-name">
					Dein Name
					<input id="full-name" type="text" name="name" autocomplete="name" required placeholder="Dein Name" aria-describedby="full-name-error" />
				</label>
				<p class="field-error" id="full-name-error" data-error-for="name" hidden></p>
				<div class="row-2">
					<label for="full-email">
						Deine E-Mail
						<input id="full-email" type="email" name="email" autocomplete="email" required placeholder="Deine E-Mail" aria-describedby="full-email-error" />
					</label>
					<label for="full-phone">
						Deine Telefonnummer
						<input id="full-phone" type="tel" name="phone" autocomplete="tel" placeholder="Deine Telefonnummer" />
					</label>
				</div>
				<p class="field-error" id="full-email-error" data-error-for="email" hidden></p>
				<fieldset class="checks">
					<legend class="lbl">Benötigte Dienstleistung</legend>
					<label><input type="checkbox" name="service" value="Webdesign" /> Webdesign</label>
					<label><input type="checkbox" name="service" value="Webentwicklung Astro" /> Webentwicklung mit Astro</label>
					<label><input type="checkbox" name="service" value="Webentwicklung Next.js" /> Webentwicklung mit Next.js</label>
					<label><input type="checkbox" name="service" value="Relaunch" /> Relaunch einer bestehenden Website</label>
				</fieldset>
				<label for="full-message">
					Nachricht
					<textarea id="full-message" name="message" rows="4" placeholder="Ich benötige Unterstützung bei..."></textarea>
				</label>
				<label class="consent" for="full-consent">
					<input id="full-consent" type="checkbox" name="consent" required aria-describedby="full-consent-error" />
					<span>
						Ich stimme zu, dass meine Angaben zur Beantwortung der Anfrage verarbeitet werden. Details in der
						<a href="/datenschutz/">Datenschutzerklärung</a>.
					</span>
				</label>
				<p class="field-error" id="full-consent-error" data-error-for="consent" hidden></p>
			</>
		)
	}

	{
		isCompact ? (
			<p class="form-note">
				Detaillierte Informationen zum Umgang mit Nutzerdaten finden Sie in unserer
				<a href="/datenschutz/">Datenschutzerklärung</a>.
			</p>
		) : null
	}

	<p class="form-status" data-status hidden role="status"></p>

	<button class="btn btn-block" type="submit" data-submit>
		{isCompact ? 'Rückruf vereinbaren' : 'Senden'}
	</button>
</form>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	.checks {
		border: 0;
		padding: 0;
		margin: 0;
	}
</style>

<script>
	import { setupKontaktForms } from '../scripts/kontakt-form';
	setupKontaktForms();
</script>
