---
import { site } from '../data/site';
---

<section class="band-lavender section-tight">
	<div class="wrap eddie-row">
		<img class="avatar" src="/images/eddie.webp" width="84" height="84" alt="Eddie J., 9to6" />
		<div>
			<div class="name">{site.person.public}</div>
			<div class="pot">Nutze dein volles Potenzial</div>
		</div>
		<a class="tel" href={site.phoneHref}>{site.phoneDisplay}</a>
		<a class="btn" href="/kontakt/">Erstgespräch</a>
	</div>
</section>
