---
type Props = {
	title?: string;
	text?: string;
	cta?: string;
	href?: string;
	secondary?: string;
	secondaryHref?: string;
};
const {
	title = 'Aus der Website werden Anfragen',
	text = 'Bring Projektart, Budgetrahmen und Zeitraum mit. Eddie antwortet persönlich.',
	cta = 'Termin wählen',
	href = '/kontakt/#kalender',
	secondary = 'Kurz schreiben',
	secondaryHref = '/kontakt/#anfrage',
} = Astro.props;
---

<section class="band-black">
	<div class="wrap">
		<h2>{title}</h2>
		<p>{text}</p>
		<hr class="rule" />
		<div class="cta-row cta-row-center">
			<a class="btn" href={href}>{cta}</a>
			{secondary ? <a class="btn btn-ghost" href={secondaryHref}>{secondary}</a> : null}
		</div>
	</div>
</section>
