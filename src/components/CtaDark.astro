---
type Props = {
	title?: string;
	text?: string;
	cta?: string;
	href?: string;
};
const {
	title = 'Aus der Website werden Anfragen',
	text = 'Bring URL und Ziel mit. Eddie sagt dir, was zuerst gebaut werden muss.',
	cta = 'Gespräch starten',
	href = '/kontakt/',
} = Astro.props;
---

<section class="band-black">
	<div class="wrap">
		<h2>{title}</h2>
		<p>{text}</p>
		<hr class="rule" />
		<a class="btn" href={href}>{cta}</a>
	</div>
</section>
