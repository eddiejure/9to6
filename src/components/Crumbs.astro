---
export type Crumb = { name: string; href: string };
type Props = { items: Crumb[] };
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Brotkrumen">
	<ol>
		<li>
			<a class="crumb-home-link" href="/" aria-label="Startseite" title="Startseite">
				<svg class="crumb-home" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
					<path
						d="M4 11.2 12 4l8 7.2"
						fill="none"
						stroke="currentColor"
						stroke-width="2.1"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
					<path
						d="M6.5 10.2V20h11V10.2"
						fill="none"
						stroke="currentColor"
						stroke-width="2.1"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
					<path
						d="M10 20v-5.5h4V20"
						fill="none"
						stroke="currentColor"
						stroke-width="2.1"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
				</svg>
			</a>
		</li>
		{
			items.map((item, index) => {
				const last = index === items.length - 1;
				return (
					<li>
						{last ? (
							<span aria-current="page">{item.name}</span>
						) : (
							<a href={item.href}>{item.name}</a>
						)}
					</li>
				);
			})
		}
	</ol>
</nav>
