---
import Picture from './Picture.astro';
import { clientCases } from '../data/site';

type Props = {
	heading?: string;
	intro?: string;
};

const {
	heading = 'Zwei Kundenprojekte, bevor es um den Termin geht',
	intro = 'Holzbau Oberlerchner in Gelnhausen und D&E Elixier in Frankfurt-Sachsenhausen. sim.do und Simtasy sind eigene Produkte und stehen nicht in dieser Reihe.',
} = Astro.props;
---

<section class="section" aria-labelledby="trust-heading">
	<div class="wrap">
		<h2 id="trust-heading" class="center">{heading}</h2>
		<p class="intro center">{intro}</p>
		<div class="cards" style="margin-top:36px">
			{
				clientCases.map((item) => (
					<a class="card" href={`/referenzen/${item.slug}/`}>
						<div class="shot">
							<Picture
								name={item.imageName}
								alt={item.imageAlt}
								class="shot-img"
								sizes="(min-width: 900px) 540px, 92vw"
								width={1280}
								height={800}
							/>
						</div>
						<div class="card-body">
							<div class="meta">Kundenprojekt · {item.place}</div>
							<h3>{item.name}</h3>
							<p>{item.result}</p>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
