---
import Picture from './Picture.astro';
import type { CaseStudy } from '../data/site';
import { clientCases } from '../data/site';

type Props = {
	eyebrow?: string;
	heading?: string;
	intro?: string;
	items?: CaseStudy[];
	headingLevel?: 'h2' | 'h3';
	id?: string;
};

const {
	eyebrow = 'Ausgewählte Arbeiten',
	heading = 'Websites, die für ihre Betriebe arbeiten',
	intro = 'Zwei Kundenprojekte aus der Region – live und zum Anklicken.',
	items = clientCases,
	id = 'arbeiten',
} = Astro.props;
---

<section class="section" aria-labelledby={`${id}-heading`} id={id}>
	<div class="wrap">
		<div class="section-head">
			<p class="eyebrow">{eyebrow}</p>
			<h2 id={`${id}-heading`}>{heading}</h2>
			{intro ? <p class="lead">{intro}</p> : null}
		</div>
		<div class="work-grid">
			{
				items.map((item) => (
					<a class="work-card" href={`/referenzen/${item.slug}/`}>
						<div class="work-shot">
							<Picture
								name={item.imageName}
								alt={item.imageAlt}
								sizes="(min-width: 900px) 580px, 92vw"
								width={1280}
								height={800}
							/>
						</div>
						<div class="work-body">
							<p class="work-meta">
								<span>{item.industry}</span>
								<span>{item.place}</span>
							</p>
							<h3>{item.name}</h3>
							<p>{item.teaser}</p>
							<span class="link-arrow">{item.kind === 'client' ? 'Projekt ansehen' : 'Produkt ansehen'}</span>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
