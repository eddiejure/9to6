---
import { briefSteps } from '../data/site';

type Props = {
	eyebrow?: string;
	heading?: string;
	intro?: string;
};

const {
	eyebrow = 'Ablauf',
	heading = 'In vier Schritten zur neuen Website',
	intro = 'Klare Schritte, ein fester Ansprechpartner und keine Überraschungen bei Zeit oder Kosten.',
} = Astro.props;
---

<section class="section" aria-labelledby="ablauf-heading">
	<div class="wrap">
		<div class="section-head">
			<p class="eyebrow">{eyebrow}</p>
			<h2 id="ablauf-heading">{heading}</h2>
			{intro ? <p class="lead">{intro}</p> : null}
		</div>
		<ol class="steps">
			{
				briefSteps.map((step, index) => (
					<li class="step">
						<span class="step-num">0{index + 1}</span>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
