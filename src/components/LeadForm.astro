---
import { mailHref } from '../lib/mail';
import { site } from '../data/site';

const directMail = mailHref();
---

<form class="form" id="lead-form" action={directMail} method="post" enctype="text/plain" data-mail={site.email}>
	<div class="row-2">
		<label>
			Name
			<input name="name" required autocomplete="name" maxlength="80" />
		</label>
		<label>
			<span>Unternehmen <span class="optional">(optional)</span></span>
			<input name="business" autocomplete="organization" maxlength="80" />
		</label>
	</div>
	<label>
		Worum geht es?
		<select name="type" required>
			<option value="">Bitte wählen</option>
			<option>Neue Website</option>
			<option>Relaunch einer bestehenden Website</option>
			<option>Nur Webdesign</option>
			<option>Nur Webentwicklung</option>
			<option>Online-Shop oder Web-App</option>
			<option>SEO, Texte oder KI-Sichtbarkeit</option>
			<option>Monatliche Partnerschaft mit Kontingent</option>
			<option>Noch offen</option>
		</select>
	</label>
	<div class="row-2">
		<label>
			Budgetrahmen
			<select name="budget" required>
				<option value="">Bitte wählen</option>
				<option>3.000 bis 6.000 Euro</option>
				<option>6.000 bis 15.000 Euro</option>
				<option>Über 15.000 Euro</option>
				<option>Lieber in monatlichen Raten</option>
				<option>Noch offen</option>
			</select>
		</label>
		<label>
			Wann soll es losgehen?
			<select name="when" required>
				<option value="">Bitte wählen</option>
				<option>So bald wie möglich</option>
				<option>In 1 bis 3 Monaten</option>
				<option>Später in diesem Jahr</option>
				<option>Noch offen</option>
			</select>
		</label>
	</div>
	<label>
		Deine Nachricht
		<textarea
			name="message"
			required
			minlength="20"
			maxlength="1200"
			placeholder="Was machst du, was soll die Website leisten, und gibt es schon eine Seite?"></textarea>
	</label>
	<button class="btn btn-block btn-lg" type="submit">Anfrage per E-Mail senden</button>
	<p class="form-note">
		Beim Absenden öffnet sich dein E-Mail-Programm mit der fertigen Nachricht an {site.email}. Es werden keine Daten auf
		dieser Website gespeichert.
	</p>
	<p class="form-status" id="lead-status" hidden></p>
</form>
<p class="form-note form-alt">
	Lieber direkt? Schreib an <a href={directMail}>{site.email}</a>.
</p>

<script>
	const form = document.querySelector<HTMLFormElement>('#lead-form');
	const status = document.querySelector<HTMLElement>('#lead-status');
	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!form.reportValidity()) return;
		const data = new FormData(form);
		const name = String(data.get('name') ?? '').trim();
		const business = String(data.get('business') ?? '').trim();
		const type = String(data.get('type') ?? '').trim();
		const budget = String(data.get('budget') ?? '').trim();
		const when = String(data.get('when') ?? '').trim();
		const message = String(data.get('message') ?? '').trim();
		const subject = `Projektanfrage: ${type}`;
		const body = [
			`Name: ${name}`,
			business ? `Unternehmen: ${business}` : null,
			`Vorhaben: ${type}`,
			`Budgetrahmen: ${budget}`,
			`Start: ${when}`,
			'',
			message,
		]
			.filter((line) => line !== null)
			.join('\n');
		const href = `mailto:${form.dataset.mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		if (status) {
			status.hidden = false;
			status.textContent = 'Dein E-Mail-Programm öffnet sich mit der fertigen Nachricht. Falls nicht, schreib bitte direkt an info@9to6.de.';
		}
		window.location.href = href;
	});
</script>
