---
import { mailHref } from '../lib/mail';
import { site } from '../data/site';

const directMail = mailHref();
---

<form class="form" id="lead-form" action={directMail} method="post" enctype="text/plain">
	<div class="row-2">
		<label>
			Name
			<input name="name" required autocomplete="name" maxlength="80" />
		</label>
		<label>
			Betrieb
			<input name="business" autocomplete="organization" maxlength="80" />
		</label>
	</div>
	<label>
		Projektart
		<select name="type" required>
			<option value="">Bitte wählen</option>
			<option>Neue Website</option>
			<option>Relaunch</option>
			<option>Webdesign</option>
			<option>Webentwicklung</option>
			<option>Noch unklar, aber ein konkretes Vorhaben</option>
		</select>
	</label>
	<div class="row-2">
		<label>
			Budget
			<select name="budget" required>
				<option value="">Bitte wählen</option>
				<option>unter 2.500 Euro</option>
				<option>2.500 bis 6.000 Euro</option>
				<option>6.000 bis 12.000 Euro</option>
				<option>über 12.000 Euro</option>
				<option>noch offen, Rahmen klären wir im Gespräch</option>
			</select>
		</label>
		<label>
			Zeitraum
			<select name="when" required>
				<option value="">Bitte wählen</option>
				<option>in den nächsten 4 Wochen</option>
				<option>in 1 bis 3 Monaten</option>
				<option>später im Jahr</option>
				<option>noch offen</option>
			</select>
		</label>
	</div>
	<label>
		Worum geht es
		<textarea name="message" required minlength="20" maxlength="800" placeholder="Zwei, drei Sätze zum Vorhaben"></textarea>
	</label>
	<p class="form-note">
		Keine Preisliste. Budget und Zeitraum zeigen nur, ob der Rahmen passt. Es öffnet sich dein E-Mail-Programm, die
		Nachricht geht an {site.email}.
	</p>
	<button class="btn btn-block" type="submit">E-Mail vorbereiten</button>
	<p class="form-status" id="lead-status" hidden></p>
</form>
<p class="form-note">
	Ohne das Feld direkt schreiben:
	<a href={directMail}>{site.email}</a>
</p>

<script>
	const form = document.querySelector<HTMLFormElement>('#lead-form');
	const status = document.querySelector<HTMLElement>('#lead-status');
	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!form.reportValidity()) return;
		const data = new FormData(form);
		const name = String(data.get('name') ?? '').trim();
		const business = String(data.get('business') ?? '').trim();
		const type = String(data.get('type') ?? '').trim();
		const budget = String(data.get('budget') ?? '').trim();
		const when = String(data.get('when') ?? '').trim();
		const message = String(data.get('message') ?? '').trim();
		const subject = `Projektanfrage: ${type}`;
		const body = [
			`Name: ${name}`,
			business ? `Betrieb: ${business}` : null,
			`Projektart: ${type}`,
			`Budget: ${budget}`,
			`Zeitraum: ${when}`,
			'',
			message,
		]
			.filter((line) => line !== null)
			.join('\n');
		const href = `mailto:info@9to6.de?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		if (status) {
			status.hidden = false;
			status.textContent = 'Dein E-Mail-Programm sollte sich jetzt öffnen. Wenn nichts aufgeht, schreib an info@9to6.de.';
		}
		window.location.href = href;
	});
</script>
