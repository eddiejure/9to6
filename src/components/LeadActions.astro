---
type Props = {
	align?: 'start' | 'center';
	primaryHref?: string;
	secondaryHref?: string;
	primaryLabel?: string;
	secondaryLabel?: string;
};

const {
	align = 'start',
	primaryHref = '/kontakt/#kalender',
	secondaryHref = '/referenzen/',
	primaryLabel = 'Erstgespräch buchen',
	secondaryLabel = 'Referenzen ansehen',
} = Astro.props;
---

<div class:list={['cta-row', align === 'center' && 'cta-row-center']}>
	<a class="btn btn-lg" href={primaryHref}>{primaryLabel}</a>
	<a class="btn btn-lg btn-ghost" href={secondaryHref}>{secondaryLabel}</a>
</div>
