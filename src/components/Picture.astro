---
import { images } from '../data/images';

type Name = keyof typeof images;

type Props = {
	name: Name;
	alt: string;
	sizes?: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	class?: string;
	width?: number;
	height?: number;
};

const { name, alt, sizes = '100vw', loading = 'lazy', fetchpriority, class: className } = Astro.props;
const img = images[name];
const width = Astro.props.width ?? img.width;
const height = Astro.props.height ?? img.height;
const srcset = (ext: 'avif' | 'webp') => img.widths.map((w) => `/images/${name}-${w}.${ext} ${w}w`).join(', ');
const fallback = `/images/${name}-${img.widths.at(-1)}.webp`;
---

<picture>
	<source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
	<source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
	<img
		class={className}
		src={fallback}
		alt={alt}
		width={width}
		height={height}
		loading={loading}
		decoding="async"
		fetchpriority={fetchpriority}
		sizes={sizes}
	/>
</picture>
