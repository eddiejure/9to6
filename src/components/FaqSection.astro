---
import Accordion from './Accordion.astro';

export type FaqItem = { q: string; a: string };

type Props = {
	title?: string;
	intro?: string;
	items: FaqItem[] | readonly FaqItem[];
};
const { title = 'Häufige Fragen', intro, items } = Astro.props;
---

<section class="section faq-block" aria-labelledby="faq-heading">
	<div class="wrap faq-grid">
		<div class="section-head">
			<p class="eyebrow">FAQ</p>
			<h2 id="faq-heading">{title}</h2>
			{intro ? <p class="lead">{intro}</p> : null}
			<p class="faq-more">
				Deine Frage ist nicht dabei? <a href="/kontakt/#anfrage">Schreib uns.</a>
			</p>
		</div>
		<Accordion items={[...items]} />
	</div>
</section>
