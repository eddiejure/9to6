---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCall from '../components/BookCall.astro';
import Accordion from '../components/Accordion.astro';
import CtaDark from '../components/CtaDark.astro';
import Related from '../components/Related.astro';
import { allFaqs, faqs, site } from '../data/site';
import { related } from '../data/related';
---

<BaseLayout
	title="Kontakt und Angebot | 9to6 Frankfurt"
	description="30-Minuten-Call mit 9to6 in Frankfurt / Rhein-Main: Webdesign und Webentwicklung, die Anfragen bringen. Termin über Cal.com oder per E-Mail."
	schema="contact"
	faqs={allFaqs}
	breadcrumbs={[{ name: 'Kontakt', href: '/kontakt/' }]}
>
	<section class="page-hero contact-hero">
		<header class="wrap hero-kicker">
			<h1>Erstgespräch Webdesign</h1>
		</header>
		<div class="contact-grid">
			<div class="profile">
				<img
					src="/images/eddie.webp"
					width="210"
					height="210"
					alt={`${site.person.public}, ${site.person.role} bei ${site.name}`}
				/>
				<h2>{site.person.public}</h2>
				<p class="role">{site.person.role}</p>
				<p class="profile-lead">
					{site.positioning} Vorher ansehen:
					<a href="/leistungen/">Leistungen</a>
					oder
					<a href="/referenzen/">Referenzen</a>.
				</p>
				<ul class="check-list">
					<li>Ziehe Interessenten an und mache den Betrieb im Netz erkennbar.</li>
					<li>Führe Besucher zu Anfrage, Termin oder Kauf.</li>
					<li>Bekomme eine Website, die nach dem Launch pflegbar bleibt.</li>
				</ul>
				<ul class="profile-links">
					<li>
						<a href={`mailto:${site.email}`}>{site.email}</a>
					</li>
					<li>
						<a href={site.social.linkedin} rel="noopener" target="_blank">LinkedIn</a>
					</li>
				</ul>
			</div>
			<BookCall />
		</div>
	</section>

	<section class="faq-block">
		<div class="wrap">
			<h2>FAQ</h2>
			<p class="intro">Die meistgestellten Fragen und deren Antworten</p>
			{
				faqs.map((group) => (
					<section style="padding:16px 0" aria-labelledby={`faq-${group.group}`}>
						<h3 class="center" id={`faq-${group.group}`}>
							{group.group}
						</h3>
						<Accordion items={[...group.items]} />
					</section>
				))
			}
		</div>
	</section>

	<Related links={related.kontakt} />
	<CtaDark
		title="Lieber schreiben?"
		text="Erzähl uns kurz, worum es geht. Wir antworten persönlich."
		cta="Mail schreiben"
		href={`mailto:${site.email}`}
	/>
</BaseLayout>
