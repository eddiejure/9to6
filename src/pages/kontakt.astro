---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCall from '../components/BookCall.astro';
import FaqSection from '../components/FaqSection.astro';
import LeadForm from '../components/LeadForm.astro';
import Testimonials from '../components/Testimonials.astro';
import Picture from '../components/Picture.astro';
import { contactFaqs, site } from '../data/site';
---

<BaseLayout
	title="Kontakt & kostenloses Erstgespräch | 9to6"
	description="Buch dir 30 Minuten mit Eddie, dem Gründer von 9to6, oder schreib eine kurze Nachricht. Kostenlos, unverbindlich, mit ehrlicher Einschätzung."
	schema="contact"
	faqs={contactFaqs}
	breadcrumbs={[{ name: 'Kontakt', href: '/kontakt/' }]}
>
	<section class="page-hero contact-hero">
		<div class="wrap contact-hero-grid">
			<div>
				<p class="eyebrow">Kontakt</p>
				<h1>Lass uns über dein Projekt sprechen.</h1>
				<p class="sub">
					Buch dir 30 Minuten mit Eddie oder schreib eine kurze Nachricht. Du bekommst eine ehrliche Einschätzung und
					konkrete nächste Schritte – kostenlos und unverbindlich.
				</p>
				<div class="cta-row">
					<a class="btn btn-lg" href="#kalender">Termin auswählen</a>
					<a class="btn btn-lg btn-ghost" href="#anfrage">Nachricht schreiben</a>
				</div>
			</div>
			<div class="contact-card">
				<Picture
					name="eddie"
					alt={`${site.person.public}, Gründer von 9to6`}
					width={840}
					height={840}
					sizes="96px"
					loading="eager"
					fetchpriority="high"
				/>
				<div>
					<p class="contact-card-name">{site.person.public}</p>
					<p class="contact-card-role">Gründer und Projektleiter<br />Dein fester Ansprechpartner</p>
				</div>
				<dl class="facts facts-compact">
					<div>
						<dt>E-Mail</dt>
						<dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
					</div>
					<div>
						<dt>Region</dt>
						<dd>Gelnhausen und Rhein-Main<br />Per Video oder vor Ort</dd>
					</div>
					<div>
						<dt>LinkedIn</dt>
						<dd><a href={site.social.linkedin} rel="noopener" target="_blank">eddiejure</a></dd>
					</div>
				</dl>
			</div>
		</div>
	</section>

	<section class="section" aria-label="Termin buchen oder Nachricht schreiben">
		<div class="wrap lead-grid">
			<div id="kalender" class="lead-panel">
				<BookCall />
			</div>
			<div id="anfrage" class="lead-panel">
				<p class="eyebrow">Nachricht</p>
				<h2>Lieber schreiben?</h2>
				<p class="body">Ein paar Angaben genügen. Du bekommst eine persönliche Antwort, kein Standardangebot.</p>
				<LeadForm />
			</div>
		</div>
	</section>

	<Testimonials eyebrow="Kundenstimmen" heading="Was Kunden über uns sagen." />

	<FaqSection items={contactFaqs} title="Fragen vor dem ersten Gespräch" />
</BaseLayout>
