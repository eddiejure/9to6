---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Accordion from '../components/Accordion.astro';
import CtaDark from '../components/CtaDark.astro';
import { faqs, site } from '../data/site';
---

<BaseLayout
	title="Kontakt und Angebot | 9to6 Frankfurt"
	description="Erstgespräch mit 9to6: Webdesign und Webentwicklung auf Astro und Next.js. Anrufen unter 0175 404 5558 oder Formular senden."
>
	<section class="page-hero center" style="min-height:52vh;padding-bottom:120px">
		<div class="wrap">
			<h1>Werde persönlich beraten</h1>
		</div>
	</section>

	<section>
		<div class="wrap-wide contact-grid">
			<div class="profile">
				<img src="/images/eddie.jpg" width="210" height="210" alt="Eddie J." />
				<h2>{site.person.public}</h2>
				<p class="role">{site.person.role}</p>
				<ul class="check-list">
					<li>Ziehe Interessenten an und mache den Betrieb im Netz erkennbar.</li>
					<li>Führe Besucher zu Anfrage, Termin oder Kauf.</li>
					<li>Bekomme eine Website, die nach dem Launch pflegbar bleibt.</li>
				</ul>
				<p><a class="btn" href={site.phoneHref}>{site.phoneDisplay}</a></p>
			</div>
			<div class="white-card">
				<ContactForm variant="full" />
			</div>
		</div>
	</section>

	<section class="faq-block">
		<div class="wrap">
			<h2>FAQ</h2>
			<p class="intro">Die meistgestellten Fragen und deren Antworten</p>
			{
				faqs.map((group) => (
					<div style="padding:16px 0">
						<h3 class="center" style="text-transform:uppercase;letter-spacing:2px">
							{group.group}
						</h3>
						<Accordion items={[...group.items]} />
					</div>
				))
			}
		</div>
	</section>

	<CtaDark />
</BaseLayout>
