---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import Related from '../../components/Related.astro';
import { posts } from '../../data/blog';
import { postRelated } from '../../data/related';
import { renderInline } from '../../lib/text';

export function getStaticPaths() {
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const links = postRelated[post.slug] ?? [];
const others = posts.filter((item) => item.slug !== post.slug);
---

<BaseLayout
	title={`${post.title} | 9to6`}
	description={post.description}
	schema="article"
	datePublished={post.date}
	dateModified={post.date}
	breadcrumbs={[
		{ name: 'Blog', href: '/blog/' },
		{ name: post.title, href: `/blog/${post.slug}/` },
	]}
>
	<section class="page-hero article-hero">
		<div class="wrap">
			<p class="article-meta">{post.dateLabel}</p>
			<h1>{post.title}</h1>
			<p class="sub">{post.hero}</p>
		</div>
	</section>

	<article class="wrap article">
		{
			post.sections.map((section) => (
				<section>
					<h2>{section.heading}</h2>
					{section.paragraphs.map((paragraph) => (
						<p set:html={renderInline(paragraph)} />
					))}
					{section.list ? (
						<ul>
							{section.list.map((item) => (
								<li set:html={renderInline(item)} />
							))}
						</ul>
					) : null}
				</section>
			))
		}

		<section aria-labelledby="more-posts">
			<h2 id="more-posts">Weitere Artikel</h2>
			<ul>
				{
					others.map((item) => (
						<li>
							<a href={`/blog/${item.slug}/`}>{item.title}</a>
						</li>
					))
				}
			</ul>
			<p>
				<a href="/blog/">Alle Artikel</a>
				{' · '}
				<a href="/leistungen/">Leistungen</a>
				{' · '}
				<a href="/kontakt/">Termin wählen</a>
			</p>
		</section>
	</article>

	<Related title="Passend zum Thema" links={links} />
	<CtaDark />
</BaseLayout>
