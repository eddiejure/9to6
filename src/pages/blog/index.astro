---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import { posts } from '../../data/blog';
---

<BaseLayout
	title="Blog: Webdesign, Conversion und Tempo | 9to6"
	description="Artikel von 9to6 aus Frankfurt: warum Websites keine Kunden bringen, wie Ladezeit das Ranking beeinflusst, und wie aus Besuchern Anfragen werden."
	schema="blog"
	breadcrumbs={[{ name: 'Blog', href: '/blog/' }]}
>
	<section class="page-hero center">
		<div class="wrap">
			<h1>Blog</h1>
			<p class="sub">Webdesign, Conversion und Performance. Für Ergebnisse, nicht für Framework-Talk.</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<p class="intro center">
				Kurze Texte aus der Praxis: was Anfragen blockiert, warum Tempo zählt, und wie eine Seite in Frankfurt und
				Rhein-Main zum Vertriebsmittel wird.
			</p>
			<div class="blog-list">
				{
					posts.map((post) => (
						<a class="blog-card" href={`/blog/${post.slug}/`}>
							<div class="meta">
								{post.dateLabel} · {post.reading}
							</div>
							<h2>{post.title}</h2>
							<p>{post.description}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<CtaDark
		title="Website prüfen lassen"
		text="Wenn deine Seite Besucher hat, aber keine Anfragen, schauen wir uns Inhalt, Tempo und den Weg zur Handlung an."
	/>
</BaseLayout>
