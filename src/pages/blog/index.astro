---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import Related from '../../components/Related.astro';
import { posts } from '../../data/blog';
import { related } from '../../data/related';
---

<BaseLayout
	title="Blog: Webdesign, Anfragen und Tempo | 9to6"
	description="Warum Seiten keine Anfragen bringen, was Ladezeit in Gelnhausen und Frankfurt ändert, und wie aus Besuch eine Nachricht wird."
	schema="blog"
	breadcrumbs={[{ name: 'Blog', href: '/blog/' }]}
>
	<section class="page-hero center">
		<div class="wrap">
			<h1>Blog: Webdesign, Anfragen und Tempo</h1>
			<p class="sub">Praxis aus Gelnhausen, dem Main-Kinzig-Kreis und Frankfurt. Ohne Framework-Talk.</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<p class="intro center">
				Kurze Texte aus der Praxis: was Anfragen blockiert, warum Tempo zählt, und wie eine Seite in Frankfurt und
				Rhein-Main zum Vertriebsmittel wird. Der Unterbau dazu steht unter
				<a href="/leistungen/webdesign/">Webdesign</a> und
				<a href="/leistungen/webentwicklung/">Webentwicklung</a>.
			</p>
			<div class="blog-list">
				{
					posts.map((post) => (
						<a class="blog-card" href={`/blog/${post.slug}/`}>
							<div class="meta">Aktualisiert {post.dateModifiedLabel}</div>
							<h2>{post.title}</h2>
							<p>{post.description}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<Related links={related.blog} />
	<CtaDark
		title="Website prüfen lassen"
		text="Wenn deine Seite Besucher hat, aber keine Anfragen, schauen wir uns Inhalt, Tempo und den Weg zur Handlung an."
	/>
</BaseLayout>
