---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import { posts } from '../../data/blog';
---

<BaseLayout
	title="Blog: Websites, die Anfragen bringen | 9to6"
	description="Praxiswissen zu Webdesign, Ladezeit und Conversion: Warum Websites keine Kunden bringen und wie du mehr Anfragen bekommst."
	schema="blog"
	breadcrumbs={[{ name: 'Blog', href: '/blog/' }]}
	itemList={posts.map((post) => ({ name: post.title, url: `/blog/${post.slug}/`, description: post.description }))}
>
	<section class="page-hero">
		<div class="wrap page-hero-grid">
			<div>
			<p class="eyebrow">Blog</p>
			<h1>Wissen für bessere Websites.</h1>
			<p class="sub">
				Praxisnahe Artikel zu Webdesign, Ladezeit und Conversion – ohne Fachchinesisch, mit Beispielen aus echten
				Projekten.
			</p>
			</div>
			<div class="hero-visual post-stack" aria-hidden="true">
				{
					posts.map((post, i) => (
						<img
							src={`/images/og-blog-${post.slug}-720.webp`}
							alt=""
							width="720"
							height="378"
							loading={i === 0 ? 'eager' : 'lazy'}
							style={`--i:${i}`}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="post-grid">
				{
					posts.map((post) => (
						<a class="post-card" href={`/blog/${post.slug}/`}>
							<p class="post-meta">
								<time datetime={post.dateModified}>{post.dateModifiedLabel}</time> · {post.readingTime} Min.
							</p>
							<h2>{post.title}</h2>
							<p>{post.description}</p>
							<span class="link-arrow">Weiterlesen</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<CtaDark
		title="Deine Website bringt keine Anfragen?"
		text="Im kostenlosen Erstgespräch schauen wir uns Inhalt, Tempo und den Weg zur Anfrage gemeinsam an."
	/>
</BaseLayout>
