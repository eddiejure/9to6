---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import Picture from '../../components/Picture.astro';
import Related from '../../components/Related.astro';
import { images } from '../../data/images';
import { cases, testimonials } from '../../data/site';
import Testimonials from '../../components/Testimonials.astro';
import { caseRelated } from '../../data/related';

export function getStaticPaths() {
	return cases.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const og = images[project.imageName];
const index = cases.findIndex((item) => item.slug === project.slug);
const next = cases[(index + 1) % cases.length];
const links = caseRelated[project.slug] ?? [];
const isClient = project.kind === 'client';
const quote = testimonials.filter((t) => t.slug === project.slug);
---

<BaseLayout
	title={project.seoTitle}
	description={project.seoDescription}
	schema="project"
	ogImagePath={project.image}
	ogImageAlt={project.imageAlt}
	ogImageWidth={og.ogWidth}
	ogImageHeight={og.ogHeight}
	work={{
		name: project.name,
		description: project.summary,
		url: project.url,
		image: project.image,
		place: project.place,
	}}
	breadcrumbs={[
		{ name: 'Referenzen', href: '/referenzen/' },
		{ name: project.name, href: `/referenzen/${project.slug}/` },
	]}
>
	<section class="page-hero project-hero">
		<div class="wrap">
			<p class="eyebrow">{isClient ? 'Kundenprojekt' : 'Eigenes Produkt'} · {project.industry}</p>
			<h1>{project.name}</h1>
			<p class="sub">{project.teaser}</p>
			<dl class="project-facts">
				<div>
					<dt>{isClient ? 'Kunde' : 'Produkt'}</dt>
					<dd>{project.name}</dd>
				</div>
				<div>
					<dt>Branche</dt>
					<dd>{project.industry}</dd>
				</div>
				<div>
					<dt>Ort</dt>
					<dd>{project.place}</dd>
				</div>
				<div>
					<dt>Website</dt>
					<dd>
						<a href={project.url} rel="noopener" target="_blank">{project.urlLabel}</a>
					</dd>
				</div>
			</dl>
		</div>
	</section>

	<section class="section section-tight">
		<div class="wrap">
			<div class="project-shot">
				{project.mockName ? (
					<Picture
						name={project.mockName}
						alt={`${project.imageAlt} – auf Laptop und Smartphone`}
						sizes="(min-width: 1240px) 1200px, 94vw"
						width={1200}
						height={1020}
						loading="eager"
					/>
				) : (
					<Picture
						name={project.imageName}
						alt={project.imageAlt}
						sizes="(min-width: 1240px) 1200px, 94vw"
						width={1280}
						height={800}
						loading="eager"
					/>
				)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap project-body">
			<div class="project-story">
				<p class="body body-lg">{project.summary}</p>
				<h2>Ausgangslage</h2>
				<p class="body">{project.challenge}</p>
				<h2>Lösung</h2>
				<p class="body">{project.solution}</p>
				<h2>Ergebnis</h2>
				<p class="body">{project.outcome}</p>
				<p class="cta-row">
					<a class="btn" href={project.url} rel="noopener" target="_blank">
						{project.urlLabel} besuchen
					</a>
				</p>
			</div>
			<aside class="project-aside" aria-labelledby="leistungen-heading">
				<p class="eyebrow" id="leistungen-heading">Leistungen</p>
				<ul class="tick-list">
					{project.deliverables.map((item) => <li>{item}</li>)}
				</ul>
				<p class="project-aside-note">
					Umgesetzt mit <a href="/leistungen/webdesign/">Webdesign</a> und
					<a href="/leistungen/webentwicklung/">Webentwicklung</a> von 9to6.
				</p>
			</aside>
		</div>
	</section>

	{quote.length > 0 ? <Testimonials items={quote} eyebrow="Stimme des Kunden" heading="" /> : null}

	<nav class="section section-tight" aria-label="Nächste Referenz">
		<div class="wrap">
			<a class="next-case" href={`/referenzen/${next.slug}/`}>
				<span class="eyebrow">Nächstes Projekt</span>
				<span class="next-case-name">{next.name}</span>
				<span class="link-arrow">{next.teaser}</span>
			</a>
		</div>
	</nav>

	<Related title="Passend dazu" links={links} />

	<CtaDark
		title={isClient ? 'Ähnliches für deinen Betrieb?' : 'Du planst ein eigenes Produkt?'}
		text={isClient
			? 'Erzähl uns im kostenlosen Erstgespräch, was du vorhast. Wir zeigen dir, wie deine Website mehr Anfragen bringt.'
			: 'Shop, Plattform oder Web-App: Im kostenlosen Erstgespräch klären wir Umfang, Technik und nächste Schritte.'}
	/>
</BaseLayout>
