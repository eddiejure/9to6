---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCall from '../components/BookCall.astro';
import CtaDark from '../components/CtaDark.astro';
import FaqSection from '../components/FaqSection.astro';
import Picture from '../components/Picture.astro';
import TrustProof from '../components/TrustProof.astro';
import Testimonials from '../components/Testimonials.astro';
import ProcessBrief from '../components/ProcessBrief.astro';
import { homeFaqs, pricing, productCases, services, site } from '../data/site';
import { posts } from '../data/blog';

const reasons = [
	{
		title: 'Ein Ansprechpartner, ein ganzes Team',
		text: 'Eddie führt dein Projekt vom ersten Gespräch bis zum Launch. Dahinter arbeitet ein eingespieltes Netzwerk aus Designern, Textern und SEO-Spezialisten.',
	},
	{
		title: 'Design und Code aus einem Guss',
		text: 'Gestaltung, Text und Entwicklung laufen in einem Prozess statt über fremde Dienstleister. Die fertige Seite sieht aus wie der Entwurf und lädt trotzdem schnell.',
	},
	{
		title: 'Texte von Spezialisten',
		text: 'Unsere Texter schreiben für Menschen, Google und KI-Assistenten zugleich. Klare Überschriften statt Floskeln, ein klarer nächster Schritt statt „Mehr erfahren“.',
	},
	{
		title: 'Flexibel bezahlen',
		text: 'Als Einmalpreis oder in monatlichen Raten mit festem Kontingent für Änderungen – an Website, Visitenkarten, Bannern und mehr.',
	},
];


---

<BaseLayout
	title="Webdesign Agentur Gelnhausen & Frankfurt | 9to6"
	description="Webdesign und Webentwicklung aus Gelnhausen: schnelle Websites, die Anfragen bringen – für Unternehmen im Main-Kinzig-Kreis, in Frankfurt und Rhein-Main."
	schema="home"
	faqs={homeFaqs}
>
	<section class="hero">
		<div class="hero-grid">
			<div class="hero-copy">
				<h1>
					<span class="hero-eyebrow">Webdesign &amp; Webentwicklung aus Gelnhausen</span>
					<span class="hero-title">Websites, die neue Kunden gewinnen.</span>
				</h1>
				<p class="hero-lede">
					Wir gestalten und entwickeln Websites für Unternehmen im Main-Kinzig-Kreis, in Frankfurt und im
					Rhein-Main-Gebiet. Schnell, klar und so gebaut, dass Besucher anfragen statt weiterzuklicken.
				</p>
				<div class="cta-row">
					<a class="btn btn-lg" href="/kontakt/#kalender">Erstgespräch buchen</a>
					<a class="btn btn-lg btn-ghost" href="#arbeiten">Arbeiten ansehen</a>
				</div>
				<ul class="hero-proof" aria-label="Auf einen Blick">
					<li>Persönliche Projektleitung</li>
					<li>Experten für Design &amp; SEO</li>
					<li>Flexible Monatsraten</li>
				</ul>
			</div>
			<BookCall variant="card" />
		</div>
	</section>

	<TrustProof />

	<Testimonials />

	<section class="section" aria-labelledby="leistungen-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Leistungen</p>
				<h2 id="leistungen-heading">Alles, was deine Website braucht. Aus einer Hand.</h2>
				<p class="lead">
					Von der ersten Skizze bis zur Empfehlung in Google und KI-Suche: Unser Team übernimmt Konzept, Texte, Design,
					Entwicklung und Hosting.
				</p>
			</div>
			<div class="service-grid">
				{
					services.map((service, index) => (
						<a class="service-card" href={service.href}>
							<span class="service-num">0{index + 1}</span>
							<h3>{service.title}</h3>
							<p>{service.teaser}</p>
							<ul class="tick-list">
								{service.points.map((point) => (
									<li>{point}</li>
								))}
							</ul>
							<span class="link-arrow">Mehr zu {service.title}</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="warum-heading">
		<div class="wrap split">
			<div class="media media-frame">
				<Picture
					name="mock-design"
					alt="Von 9to6 gestaltete Website von D&E Elixier auf Laptop und Smartphone"
					sizes="(min-width: 900px) 560px, 92vw"
					width={1200}
					height={1020}
				/>
			</div>
			<div>
				<p class="eyebrow">Warum 9to6</p>
				<h2 id="warum-heading">Weniger Agentur. Mehr Ergebnis.</h2>
				<div class="reason-list">
					{
						reasons.map((item) => (
							<div class="reason">
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="preise-heading">
		<div class="wrap invest-teaser">
			<div>
				<p class="eyebrow">Investition</p>
				<h2 id="preise-heading">Eine Website, die sich bezahlt macht.</h2>
				<p class="body">
					Projekte starten üblicherweise bei {pricing.typicalRange} – einmalig oder in monatlichen Raten, deren Höhe sich
					nach der Laufzeit richtet. Große Vorhaben kalkulieren wir individuell. Entscheidend ist nicht der Preis, sondern
					was deine Website dir einbringt.
				</p>
				<div class="cta-row">
					<a class="btn" href="/preise/#rechner">Rendite berechnen</a>
					<a class="link-arrow" href="/preise/">Preise und Modelle</a>
				</div>
			</div>
			<div class="invest-example">
				<p class="price-label">Beispielrechnung</p>
				<p class="roi-big">5 Monate</p>
				<p class="roi-sub">bis sich eine Website für 5.000 € bezahlt gemacht hat</p>
				<dl class="roi-stats">
					<div>
						<dt>Gewinn pro neuem Auftrag</dt>
						<dd>1.000 €</dd>
					</div>
					<div>
						<dt>Zusätzliche Aufträge pro Monat</dt>
						<dd>1</dd>
					</div>
					<div>
						<dt>Mehrgewinn nach 3 Jahren</dt>
						<dd>31.000 €</dd>
					</div>
				</dl>
				<p class="form-note" style="margin-top:14px">Beispiel mit angenommenen Werten, keine Zusage.</p>
			</div>
		</div>
	</section>

	<ProcessBrief />





	<section class="section" aria-labelledby="ueber-heading">
		<div class="wrap about">
			<div class="about-photo">
				<Picture
					name="eddie"
					alt={`${site.person.public} (${site.person.legal}), Gründer von 9to6`}
					width={840}
					height={840}
					sizes="(min-width: 900px) 640px, 90vw"
				/>
			</div>
			<div>
				<p class="eyebrow">Über 9to6</p>
				<h2 id="ueber-heading">Agentur-Expertise ohne Agentur-Overhead.</h2>
				<p class="body">
					9to6 wurde {site.foundingYear} in Gelnhausen von Edvinas „Eddie“ Jurevicius gegründet. Eddie leitet jedes
					Projekt und ist dein fester Ansprechpartner. Für Design, Texte und Sichtbarkeit in Google und KI-Suche arbeitet er
					mit einem festen Netzwerk aus spezialisierten Designern und Textern zusammen.
				</p>
				<p class="body">
					Mit sim.do und Simtasy betreibt das Team außerdem eigene Online-Produkte. Du bekommst also Leute, die Websites
					nicht nur bauen, sondern aus eigener Erfahrung wissen, wie sie verkaufen.
				</p>
				<ul class="mini-products" aria-label="Eigene Produkte">
					{
						productCases.map((item) => (
							<li>
								<a href={`/referenzen/${item.slug}/`}>
									<Picture name={item.imageName} alt="" sizes="96px" width={1280} height={800} />
									<span>
										<strong>{item.name}</strong>
										<span>{item.industry}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<dl class="facts">
					<div>
						<dt>Team</dt>
						<dd>Projektleitung, Design, Text, SEO und Entwicklung</dd>
					</div>
					<div>
						<dt>Region</dt>
						<dd>
							<a href="/webdesign-gelnhausen/">Gelnhausen</a>, Main-Kinzig-Kreis, Hanau, Offenbach, Frankfurt
						</dd>
					</div>
					<div>
						<dt>Für</dt>
						<dd>Handwerk, Studios, Dienstleister und Produktmarken</dd>
					</div>
					<div>
						<dt>Kontakt</dt>
						<dd>
							<a href={`mailto:${site.email}`}>{site.email}</a>
						</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>



	<section class="section" aria-labelledby="blog-heading">
		<div class="wrap">
			<div class="section-head section-head-row">
				<div>
					<p class="eyebrow">Wissen</p>
					<h2 id="blog-heading">Aus dem Blog</h2>
				</div>
				<a class="link-arrow" href="/blog/">Alle Artikel</a>
			</div>
			<div class="post-grid">
				{
					posts.map((post) => (
						<a class="post-card" href={`/blog/${post.slug}/`}>
							<p class="post-meta">{post.readingTime} Min. Lesezeit</p>
							<h3>{post.title}</h3>
							<p>{post.description}</p>
							<span class="link-arrow">Weiterlesen</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<FaqSection items={homeFaqs} title="Häufige Fragen zu 9to6" />

	<CtaDark />
</BaseLayout>
