---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCall from '../components/BookCall.astro';
import CtaDark from '../components/CtaDark.astro';
import Accordion from '../components/Accordion.astro';
import Blob from '../components/Blob.astro';
import Picture from '../components/Picture.astro';
import TrustProof from '../components/TrustProof.astro';
import ProcessBrief from '../components/ProcessBrief.astro';
import { productCases, site } from '../data/site';
import { posts } from '../data/blog';

const pillars = [
	{
		title: 'Webdesign, das zum Betrieb passt',
		text: 'Struktur, Sprache und Erscheinungsbild für Handwerk, Studios und lokale Marken. Die Seite soll in Gelnhausen, Frankfurt oder der Umgebung nach dir aussehen und zur Anfrage führen.',
		href: '/leistungen/webdesign/',
		cta: 'Zu Webdesign',
		visual: 'studio' as const,
	},
	{
		title: 'Seiten, die Anfragen bringen',
		text: 'Besucher sollen schreiben oder einen Termin buchen. Der Weg dorthin ist kurz: ein klares Angebot und eine Handlung, die auf dem Handy erreichbar ist.',
		href: '/leistungen/webentwicklung/',
		cta: 'Zur Webentwicklung',
		visual: 'leads' as const,
	},
	{
		title: 'Tempo, das Leute hält',
		text: 'Eine schwere Seite kostet Sichtbarkeit und Abschlüsse. Bilder in der richtigen Größe, wenig Ballast, auf dem Smartphone sofort lesbar.',
		href: '/blog/core-web-vitals-und-google-ranking/',
		cta: 'Warum Ladezeit zählt',
		visual: 'speed' as const,
	},
	{
		title: 'Gefunden werden, dann handeln',
		text: 'Inhalte, URLs und interne Wege so setzen, dass Menschen und Suchmaschinen denselben Pfad zur Anfrage gehen. Gebiet inklusive: Main-Kinzig-Kreis, Frankfurt, Hanau, Offenbach.',
		href: '/webdesign-gelnhausen/',
		cta: 'Einzugsgebiet ansehen',
		visual: 'laptop' as const,
	},
];

const ansatz = [
	{
		title: 'Ziele zuerst',
		text: 'Bevor ein Raster entsteht, klären wir, wen du gewinnen willst und welche Handlung zählt: Nachricht, Termin, Kauf.',
	},
	{
		title: 'Design mit System',
		text: 'Typografie, Farbe und Abstände sitzen. Die Seite sieht nach dir aus, nicht nach einem Theme.',
	},
	{
		title: 'Technik, die trägt',
		text: 'Moderne Webtechnik bleibt im Hintergrund. Du merkst Tempo, Stabilität und einen Anfrageweg, der ankommt.',
	},
	{
		title: 'Nach dem Launch',
		text: 'Ladezeit, mobile Bedienung, echte Anfragen. Was sich beobachten lässt, schärfen wir nach.',
	},
	{
		title: 'Ein Ansprechpartner',
		text: 'Eddie führt das Gespräch selbst. Kein Ticket-Pingpong zwischen dir und der fertigen Seite.',
	},
];
---

<BaseLayout
	title="Webdesign aus Gelnhausen für Frankfurt | 9to6"
	description="Webdesign und Webentwicklung aus Gelnhausen. Für den Main-Kinzig-Kreis, Frankfurt, Hanau und Offenbach. Termin buchen oder per E-Mail schreiben."
	schema="home"
	ogImagePath="/images/ref-oberlerchner-og.jpg"
	ogImageAlt="Website von Holzbau Oberlerchner, Kundenprojekt in Gelnhausen"
	ogImageWidth={1200}
	ogImageHeight={750}
>
	<section class="hero">
		<div class="hero-grid">
			<header>
				<h1>
					<span class="hero-line">Webdesign &amp;</span>
					<span class="hero-line">Webentwicklung</span>
					<span class="hero-line hero-loc">aus Gelnhausen für Frankfurt und Umgebung</span>
				</h1>
				<p class="lede">
					Sitz in Gelnhausen. Seiten für den Main-Kinzig-Kreis, Frankfurt, Hanau und Offenbach.
				</p>
			</header>
			<BookCall variant="card" />
		</div>
	</section>

	<TrustProof />
	<ProcessBrief />

	{
		pillars.map((pillar, index) => (
			<section class="section">
				<div class={'wrap-wide split' + (index % 2 === 1 ? ' reverse' : '')}>
					<div class="copy">
						<h2>{pillar.title}</h2>
						<p class="body">{pillar.text}</p>
						<p>
							<a class="btn" href={pillar.href} style="margin-top:18px">
								{pillar.cta}
							</a>
						</p>
					</div>
					<div class="media" aria-hidden={pillar.visual === 'leads' || pillar.visual === 'speed'}>
						{pillar.visual === 'studio' ? (
							<Picture name="studio" alt="" sizes="(min-width: 900px) 560px, 92vw" />
						) : pillar.visual === 'laptop' ? (
							<Picture name="laptop" alt="" sizes="(min-width: 900px) 560px, 92vw" />
						) : (
							<Blob label={pillar.visual === 'leads' ? 'Anfragen' : 'Tempo'} />
						)}
					</div>
				</div>
			</section>
		))
	}

	<section class="section center">
		<div class="wrap">
			<h2>Was den Kern ausmacht</h2>
			<p class="intro">
				{site.positioning} Der Sitz ist Gelnhausen. Die Arbeit gilt Betrieben im Main-Kinzig-Kreis und in Frankfurt,
				Hanau und Offenbach. Den Rahmen findest du unter <a href="/leistungen/">Leistungen</a>.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap-wide split">
			<div class="media">
				<Picture
					name="ref-elixier"
					alt="Startseite von D&E Elixier, Kosmetikinstitut in Frankfurt-Sachsenhausen"
					class="shot-img"
					sizes="(min-width: 900px) 560px, 92vw"
					width={1280}
					height={800}
				/>
			</div>
			<div>
				<h2>Ein Ansprechpartner, live Beispiele</h2>
				<Accordion
					items={ansatz.map((item) => ({
						q: item.title,
						a: item.text,
					}))}
				/>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="products-heading">
		<div class="wrap">
			<h2 id="products-heading" class="center">Eigene Produkte</h2>
			<p class="intro center">
				sim.do und Simtasy gehören Eddie. Sie sind kein Kundenauftrag aus Gelnhausen oder Frankfurt. Die Kundenprojekte
				stehen oben.
			</p>
			<div class="cards" style="margin-top:36px">
				{
					productCases.map((item) => (
						<a class="card" href={`/referenzen/${item.slug}/`}>
							<div class="shot">
								<Picture
									name={item.imageName}
									alt={item.imageAlt}
									class="shot-img"
									sizes="(min-width: 900px) 540px, 92vw"
									width={1280}
									height={800}
								/>
							</div>
							<div class="card-body">
								<div class="meta">Eigenes Produkt · {item.place}</div>
								<h3>{item.name}</h3>
								<p>{item.result}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="blog-heading">
		<div class="wrap">
			<h2 id="blog-heading" class="center">Aus der Praxis</h2>
			<p class="intro center">
				Woran Anfragen scheitern, warum Tempo zählt, und wie aus einem Besuch eine Nachricht wird. Der
				<a href="/blog/">Blog</a>.
			</p>
			<div class="blog-list">
				{
					posts.map((post) => (
						<a class="blog-card" href={`/blog/${post.slug}/`}>
							<div class="meta">Aktualisiert {post.dateModifiedLabel}</div>
							<h3>{post.title}</h3>
							<p>{post.description}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<CtaDark
		title="Termin oder kurze E-Mail"
		text="Projektart, Budgetrahmen und Zeitraum reichen für den ersten Schritt. Eddie meldet sich selbst."
	/>
</BaseLayout>
