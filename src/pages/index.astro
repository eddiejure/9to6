---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCall from '../components/BookCall.astro';
import CtaPhone from '../components/CtaPhone.astro';
import CtaDark from '../components/CtaDark.astro';
import Accordion from '../components/Accordion.astro';
import Blob from '../components/Blob.astro';
import { cases, site } from '../data/site';
import { posts } from '../data/blog';

const pillars = [
	{
		title: 'Webdesign, das überzeugt',
		text: 'Dein Unternehmen ist einzigartig und verdient eine Website, die das zeigt. Wir verbinden klares Design mit einer ruhigen Benutzerführung und legen damit den Grundstein für Anfragen, Termine und Umsatz.',
		href: '/leistungen/webdesign/',
		cta: 'Zu Webdesign',
		visual: 'studio',
	},
	{
		title: 'Seiten, die Anfragen bringen',
		text: 'Besucher sollen nicht nur schauen. Sie sollen anrufen, schreiben oder buchen. Wir bauen den Weg zur Handlung so kurz, dass aus Interesse ein konkreter nächster Schritt wird.',
		href: '/leistungen/webentwicklung/',
		cta: 'Zur Webentwicklung',
		visual: 'leads',
	},
	{
		title: 'Tempo, das Kunden hält',
		text: 'Eine langsame Seite kostet Sichtbarkeit und Abschlüsse. Wir liefern Auftritte, die auf dem Smartphone sofort da sind, in der Suche bestehen und messbar mehr Anfragen generieren.',
		href: '/blog/core-web-vitals-und-google-ranking/',
		cta: 'Warum Ladezeit zählt',
		visual: 'speed',
	},
	{
		title: 'Gefunden werden, dann verkaufen',
		text: 'Eine schnelle Seite ohne klare Struktur bleibt unsichtbar. Inhalte, URLs und interne Wege so setzen, dass Menschen und Suchmaschinen denselben Pfad zur Anfrage gehen.',
		href: '/blog/aus-besuchern-werden-anfragen/',
		cta: 'Wie aus Besuch Anfrage wird',
		visual: 'laptop',
	},
];

const ansatz = [
	{
		title: 'Ziele zuerst',
		text: 'Bevor ein Raster entsteht, klären wir, wen du gewinnen willst und welche Handlung zählt: Anfrage, Termin, Kauf.',
	},
	{
		title: 'Design mit System',
		text: 'Typografie, Farbe und Abstände sitzen. Die Seite sieht nach dir aus, nicht nach einem Theme.',
	},
	{
		title: 'Technik, die unsichtbar trägt',
		text: 'Moderne Webtechnik bleibt im Hintergrund. Du merkst das Ergebnis: Tempo, Stabilität, Formulare, die ankommen.',
	},
	{
		title: 'Messbar schnell',
		text: 'Ladezeit, Formulare, mobile Bedienung. Was sich messen lässt, verbessern wir nach dem Launch.',
	},
	{
		title: 'Direkt ansprechbar',
		text: 'Ein fester Ansprechpartner. Kein Ticket-Pingpong, keine Agentur-Hierarchie zwischen dir und der fertigen Seite.',
	},
];
---

<BaseLayout
	title="Webdesign und Webentwicklung in Frankfurt | 9to6"
	description="9to6 in Frankfurt / Rhein-Main: Full-Service für den Webauftritt, Schwerpunkt Webdesign und Webentwicklung. Websites, die Kunden anziehen und Anfragen bringen."
	schema="home"
>
	<section class="hero">
		<div class="hero-grid">
			<header>
				<h1>
					<span class="hero-line nowrap">Webdesign &amp;</span>
					<span class="hero-line nowrap">Webentwicklung</span>
					<span class="hero-line hero-loc">Agentur Frankfurt / Rhein-Main</span>
				</h1>
				<p class="lede">{site.tagline}</p>
			</header>
			<BookCall variant="card" />
		</div>
	</section>

	<section class="section center">
		<div class="wrap">
			<h2 class="grad-title">Websites, die arbeiten</h2>
			<p class="intro">
				{site.positioning} Sitz in Gelnhausen, Arbeit für Betriebe in Frankfurt am Main, der Region und darüber
				hinaus. Den Überblick über den Rahmen findest du unter
				<a href="/leistungen/">Leistungen</a>.
			</p>
		</div>
	</section>

	{
		pillars.map((p, i) => {
			const mediaOnRight = p.visual === 'speed';
			return (
			<section class="section">
				<div class={'wrap-wide split' + (i % 2 === 1 ? ' reverse' : '')}>
					{i % 2 === 0 && !mediaOnRight ? (
						<div class="media" aria-hidden={p.visual === 'leads' || p.visual === 'speed'}>
							{p.visual === 'studio' ? (
								<img src="/images/studio.webp" alt="" width="640" height="427" />
							) : p.visual === 'laptop' ? (
								<img src="/images/laptop.webp" alt="" width="640" height="427" />
							) : (
								<Blob label={p.visual === 'leads' ? 'Anfragen' : 'Tempo'} />
							)}
						</div>
					) : null}
					<div class="copy">
						<h2>{p.title}</h2>
						<p class="body">{p.text}</p>
						<p>
							<a class="btn" href={p.href} style="margin-top:18px">
								{p.cta}
							</a>
						</p>
					</div>
					{i % 2 === 1 || mediaOnRight ? (
						<div class="media">
							{p.visual === 'leads' || p.visual === 'speed' ? (
								<Blob label={p.visual === 'leads' ? 'Anfragen' : 'Tempo'} />
							) : (
								<img src="/images/workspace.webp" alt="" width="640" height="427" />
							)}
						</div>
					) : null}
				</div>
			</section>
			);
		})
	}

	<CtaPhone
		heading="Direkt mit Eddie sprechen"
		text="Eddie nimmt den Call selbst. Kein Vertrieb, keine Weiterleitung."
		cta="Zum Kalender"
	/>

	<section class="section center">
		<div class="wrap">
			<h2>Was macht uns besonders?</h2>
			<p class="intro">
				Viele Agenturen verkaufen Kampagnen auf einer schwachen Grundlage. 9to6 baut zuerst die Grundlage:
				<a href="/leistungen/webdesign/">Webdesign</a> und
				<a href="/leistungen/webentwicklung/">Webentwicklung</a> in einem Prozess. Relaunch, Hosting und der Weg zur
				Anfrage gehören dazu, ohne den Kern zu verwässern.
			</p>
			<p>
				<a class="btn" href="/kontakt/">Gespräch vereinbaren</a>
			</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap-wide split">
			<div class="media">
				<img src="/images/boost.webp" alt="Team bei der Arbeit am Webauftritt" width="640" height="586" />
			</div>
			<div>
				<h2>Unser Ansatz für nachhaltige Websites</h2>
				<Accordion
					items={ansatz.map((a) => ({
						q: a.title,
						a: a.text,
					}))}
				/>
			</div>
		</div>
	</section>

	<section class="section center">
		<div class="wrap">
			<h2>Webdesign und Entwicklung, die zu deinem Alltag passen</h2>
			<p class="intro">
				Handwerk, Studio, Produktmarke oder interne Plattform: Wir schauen uns an, was schon da ist, und bauen das, was
				fehlt. Ohne Theme-Zwang, ohne Ballast, der Kunden ausbremst. Ablauf und Zielgruppen stehen unter
				<a href="/leistungen/">Leistungen</a>.
			</p>
			<p>
				<a class="btn" href="/leistungen/">Leistungen ansehen</a>
			</p>
		</div>
	</section>

	<section class="section" aria-labelledby="cases-heading">
		<div class="wrap">
			<h2 id="cases-heading" class="center">Websites, die im Einsatz sind</h2>
			<p class="intro center">
				Echte Auftritte, keine Moodboards. Kundenprojekte und Gründerprodukte sind getrennt gekennzeichnet.
				<a href="/referenzen/">Alle Referenzen</a>.
			</p>
			<div class="cards" style="margin-top:36px">
				{
					cases.map((c) => (
						<a class="card" href={`/referenzen/${c.slug}/`}>
							<div class="shot">
								<img class="shot-img" src={c.image} alt={c.imageAlt} width="1280" height="800" />
							</div>
							<div class="card-body">
								<div class="meta">{c.place}</div>
								<h3>{c.name}</h3>
								<p>{c.role}</p>
								<div class="pills">
									<span class="pill">{c.stack}</span>
									{c.founder ? <span class="pill">Gründerprojekt</span> : <span class="pill">Kundenprojekt</span>}
								</div>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="blog-heading">
		<div class="wrap">
			<h2 id="blog-heading" class="center">Aus der Praxis</h2>
			<p class="intro center">
				Kurze Texte dazu, woran Anfragen scheitern und warum Tempo zählt. Der
				<a href="/blog/">Blog</a> bleibt absichtlich ohne Framework-Talk.
			</p>
			<div class="blog-list">
				{
					posts.map((post) => (
						<a class="blog-card" href={`/blog/${post.slug}/`}>
							<div class="meta">{post.dateLabel}</div>
							<h3>{post.title}</h3>
							<p>{post.description}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<CtaDark />
</BaseLayout>
