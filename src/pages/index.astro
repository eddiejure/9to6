---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import CtaPhone from '../components/CtaPhone.astro';
import CtaDark from '../components/CtaDark.astro';
import Accordion from '../components/Accordion.astro';
import { cases, site } from '../data/site';

const pillars = [
	{
		title: 'Webdesign, das beeindruckt',
		text: 'Dein Unternehmen ist einzigartig und verdient eine Website, die das zeigt. Wir verbinden klares Design mit einer ruhigen Benutzerführung und legen damit den Grundstein deiner Onlinepräsenz.',
		href: '/leistungen/webdesign',
		cta: 'Zu unseren Webdesign Leistungen',
		visual: 'studio',
	},
	{
		title: 'Webentwicklung mit Astro',
		text: 'Astro liefert HTML zuerst und JavaScript nur dort, wo es gebraucht wird. Das heißt: kurze Ladezeiten, gute Core Web Vitals und Seiten, die in der Suche bestehen. Ideal für Agentur-, Handwerks- und Markenauftritte.',
		href: '/leistungen/webentwicklung#astro',
		cta: 'Mehr zu Astro',
		visual: 'astro',
	},
	{
		title: 'Next.js, wenn es komplex wird',
		text: 'Login, Dashboard, Shop-Logik, häufige Updates: Dann trägt Next.js. Wir bauen die Anwendung so, dass sie wartbar bleibt und sich anfühlt wie ein Produkt, nicht wie ein Baukasten.',
		href: '/leistungen/webentwicklung#nextjs',
		cta: 'Mehr zu Next.js',
		visual: 'next',
	},
	{
		title: 'Technik, die gefunden wird',
		text: 'Eine schnelle Seite ohne klare Struktur bleibt unsichtbar. Wir setzen semantisches HTML, saubere URLs, Metadaten und interne Verlinkung so, dass Menschen und Suchmaschinen denselben Weg gehen.',
		href: '/leistungen/webentwicklung',
		cta: 'Zur Webentwicklung',
		visual: 'laptop',
	},
];

const ansatz = [
	{
		title: 'Inhalte zuerst',
		text: 'Bevor ein Raster entsteht, klären wir Ziel, Angebot und die Seiten, die wirklich gebraucht werden.',
	},
	{
		title: 'Design mit System',
		text: 'Typografie, Farbe und Abstände sitzen. Die Seite sieht nach dir aus, nicht nach einem Theme.',
	},
	{
		title: 'Astro oder Next.js',
		text: 'Der Stack folgt der Aufgabe. Wir erklären die Wahl so, dass du sie mittragen kannst.',
	},
	{
		title: 'Messbar schnell',
		text: 'Ladezeit, Formulare, mobile Bedienung. Was sich messen lässt, verbessern wir nach dem Launch.',
	},
	{
		title: 'Direkt ansprechbar',
		text: 'Ein fester Ansprechpartner. Kein Ticket-Pingpong, keine Agentur-Hierarchie zwischen dir und dem Code.',
	},
];
---

<BaseLayout
	title="Webdesign und Webentwicklung in Frankfurt | 9to6"
	description="9to6 baut Websites auf Astro und Next.js. Webdesign und Webentwicklung in Frankfurt und Rhein-Main: schnell, klar, suchstark."
>
	<section class="hero">
		<div class="hero-grid">
			<div>
				<h1>Webdesign<br />und<br />Webentwicklung</h1>
				<p class="lede">Websites auf Astro und Next.js. Schnell, klar und bereit für Anfragen.</p>
			</div>
			<div class="glass">
				<svg class="phone-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"
					></path>
				</svg>
				<a class="phone" href={site.phoneHref}>{site.phoneDisplay}</a>
				<p>Rufe uns an oder vereinbare ein kostenloses Erstgespräch</p>
				<ContactForm variant="compact" heading="" />
			</div>
		</div>
	</section>

	<section class="section center">
		<div class="wrap">
			<h2 class="grad-title">Websites, die arbeiten</h2>
			<p class="intro">
				Zwischen Marke, Kanal und erstem Klick entscheidet die Website. 9to6 gestaltet und entwickelt Auftritte, die dein
				Angebot verständlich machen, schnell laden und so gebaut sind, dass Interessenten den nächsten Schritt finden.
				Schwerpunkt Astro und Next.js, Sitz in Frankfurt am Main, Arbeit für Betriebe in der Region und darüber hinaus.
			</p>
		</div>
	</section>

	{
		pillars.map((p, i) => (
			<section class="section">
				<div class={'wrap-wide split' + (i % 2 === 1 ? ' reverse' : '')}>
					{i % 2 === 0 ? (
						<div class="media" aria-hidden={p.visual === 'astro' || p.visual === 'next'}>
							{p.visual === 'studio' ? (
								<img src="/images/studio.webp" alt="" width="640" height="427" />
							) : p.visual === 'laptop' ? (
								<img src="/images/laptop.webp" alt="" width="640" height="427" />
							) : (
								<div class="blob">{p.visual === 'astro' ? 'Astro' : 'Next.js'}</div>
							)}
						</div>
					) : null}
					<div class="copy">
						<h3>{p.title}</h3>
						<p class="body">{p.text}</p>
						<p><a class="btn" href={p.href} style="margin-top:18px">{p.cta}</a></p>
					</div>
					{i % 2 === 1 ? (
						<div class="media">
							{p.visual === 'astro' || p.visual === 'next' ? (
								<div class="blob">{p.visual === 'astro' ? 'Astro' : 'Next.js'}</div>
							) : (
								<img src="/images/workspace.webp" alt="" width="640" height="427" />
							)}
						</div>
					) : null}
				</div>
			</section>
		))
	}

	<CtaPhone />

	<section class="section center">
		<div class="wrap">
			<h2>Was macht uns besonders?</h2>
			<p class="intro">
				9to6 ist eine Agentur mit Sitz in Frankfurt am Main. Wir helfen Unternehmen mit Webdesign und Webentwicklung
				auf Astro und Next.js, online klarer aufzutreten und Anfragen zu gewinnen. Jedes Projekt bekommt eine Lösung, die
				zu Ziel, Inhalt und Budget passt.
			</p>
			<p><a class="btn" href="/agentur">Über uns</a></p>
		</div>
	</section>

	<section class="section">
		<div class="wrap-wide split">
			<div class="media">
				<img src="/images/boost.webp" alt="Team bei der Arbeit am Webauftritt" width="640" height="586" />
			</div>
			<div>
				<h2>Unser Ansatz für nachhaltige Websites</h2>
				<Accordion
					items={ansatz.map((a) => ({
						q: a.title,
						a: a.text,
					}))}
				/>
			</div>
		</div>
	</section>

	<section class="section center">
		<div class="wrap">
			<h2>Webdesign und Entwicklung, die zu deinem Alltag passen</h2>
			<p class="intro">
				Handwerk, Studio, Produktmarke oder interne Plattform: Wir schauen uns an, was schon da ist, und bauen das, was
				fehlt. Ohne Theme-Zwang, ohne unnötiges JavaScript.
			</p>
			<p><a class="btn" href="/leistungen">Leistungen</a></p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<h2 class="center">Websites, die im Einsatz sind</h2>
			<p class="intro center">Echte Auftritte, keine Moodboards. Mehr dazu unter Referenzen.</p>
			<div class="cards" style="margin-top:36px">
				{
					cases.map((c) => (
						<a class="card" href="/referenzen">
							<img src={c.image} alt={c.imageAlt} width="640" height="400" />
							<div class="card-body">
								<div class="meta">{c.place}</div>
								<h3>{c.name}</h3>
								<p>{c.role}</p>
								<div class="pills">
									<span class="pill">{c.stack}</span>
									{c.founder ? <span class="pill">Gründerprojekt</span> : <span class="pill">Kundenprojekt</span>}
								</div>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<CtaDark />
</BaseLayout>
