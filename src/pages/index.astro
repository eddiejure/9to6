---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import CtaPhone from '../components/CtaPhone.astro';
import CtaDark from '../components/CtaDark.astro';
import Accordion from '../components/Accordion.astro';
import { cases, site } from '../data/site';

const pillars = [
	{
		title: 'Webdesign, das überzeugt',
		text: 'Dein Unternehmen ist einzigartig und verdient eine Website, die das zeigt. Wir verbinden klares Design mit einer ruhigen Benutzerführung und legen damit den Grundstein für Anfragen, Termine und Umsatz.',
		href: '/leistungen/webdesign/',
		cta: 'Zu unseren Webdesign Leistungen',
		visual: 'studio',
	},
	{
		title: 'Seiten, die Anfragen bringen',
		text: 'Besucher sollen nicht nur schauen. Sie sollen anrufen, schreiben oder buchen. Wir bauen den Weg zur Handlung so kurz, dass aus Interesse ein konkreter nächster Schritt wird.',
		href: '/leistungen/webentwicklung/',
		cta: 'Zur Webentwicklung',
		visual: 'leads',
	},
	{
		title: 'Tempo, das Kunden hält',
		text: 'Eine langsame Seite kostet Sichtbarkeit und Abschlüsse. Wir liefern Auftritte, die auf dem Smartphone sofort da sind, in der Suche bestehen und messbar mehr Anfragen generieren.',
		href: '/leistungen/webentwicklung/',
		cta: 'Mehr zu Performance',
		visual: 'speed',
	},
	{
		title: 'Gefunden werden, dann verkaufen',
		text: 'Eine schnelle Seite ohne klare Struktur bleibt unsichtbar. Wir setzen Inhalte, URLs und interne Wege so, dass Menschen und Suchmaschinen denselben Pfad zur Anfrage gehen.',
		href: '/leistungen/webentwicklung/',
		cta: 'Zur Webentwicklung',
		visual: 'laptop',
	},
];

const ansatz = [
	{
		title: 'Ziele zuerst',
		text: 'Bevor ein Raster entsteht, klären wir, wen du gewinnen willst und welche Handlung zählt: Anfrage, Termin, Kauf.',
	},
	{
		title: 'Design mit System',
		text: 'Typografie, Farbe und Abstände sitzen. Die Seite sieht nach dir aus, nicht nach einem Theme.',
	},
	{
		title: 'Technik, die unsichtbar trägt',
		text: 'Moderne Webtechnik bleibt im Hintergrund. Du merkst das Ergebnis: Tempo, Stabilität, Formulare, die ankommen.',
	},
	{
		title: 'Messbar schnell',
		text: 'Ladezeit, Formulare, mobile Bedienung. Was sich messen lässt, verbessern wir nach dem Launch.',
	},
	{
		title: 'Direkt ansprechbar',
		text: 'Ein fester Ansprechpartner. Kein Ticket-Pingpong, keine Agentur-Hierarchie zwischen dir und der fertigen Seite.',
	},
];
---

<BaseLayout
	title="Webdesign und Webentwicklung in Frankfurt | 9to6"
	description="Agentur für Webdesign und Webentwicklung in Frankfurt und Rhein-Main. Moderne Websites, die neue Kunden anziehen und messbar Anfragen generieren."
	schema="home"
>
	<section class="hero">
		<div class="hero-grid">
			<header>
				<h1>
					<span class="hero-line nowrap">Webdesign &amp;</span>
					<span class="hero-line nowrap">Webentwicklung</span>
					<span class="hero-line hero-loc">Agentur aus Frankfurt</span>
				</h1>
				<p class="lede">Moderne Websites, die neue Kunden anziehen und messbar Anfragen generieren.</p>
			</header>
			<div class="glass">
				<svg class="phone-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"
					></path>
				</svg>
				<a class="phone" href={site.phoneHref}>{site.phoneDisplay}</a>
				<p>Rufe uns an oder vereinbare ein kostenloses Erstgespräch</p>
				<ContactForm variant="compact" heading="" />
			</div>
		</div>
	</section>

	<section class="section center">
		<div class="wrap">
			<h2 class="grad-title">Websites, die arbeiten</h2>
			<p class="intro">
				Zwischen Marke, Kanal und erstem Klick entscheidet die Website. 9to6 gestaltet und entwickelt Auftritte, die dein
				Angebot verständlich machen, schnell laden und so gebaut sind, dass Interessenten den nächsten Schritt finden.
				Agentur in Frankfurt am Main, Arbeit für Betriebe in der Region und darüber hinaus.
			</p>
		</div>
	</section>

	{
		pillars.map((p, i) => (
			<section class="section">
				<div class={'wrap-wide split' + (i % 2 === 1 ? ' reverse' : '')}>
					{i % 2 === 0 ? (
						<div class="media" aria-hidden={p.visual === 'leads' || p.visual === 'speed'}>
							{p.visual === 'studio' ? (
								<img src="/images/studio.webp" alt="" width="640" height="427" />
							) : p.visual === 'laptop' ? (
								<img src="/images/laptop.webp" alt="" width="640" height="427" />
							) : (
								<div class="blob">{p.visual === 'leads' ? 'Anfragen' : 'Tempo'}</div>
							)}
						</div>
					) : null}
					<div class="copy">
						<h2>{p.title}</h2>
						<p class="body">{p.text}</p>
						<p>
							<a class="btn" href={p.href} style="margin-top:18px">
								{p.cta}
							</a>
						</p>
					</div>
					{i % 2 === 1 ? (
						<div class="media">
							{p.visual === 'leads' || p.visual === 'speed' ? (
								<div class="blob">{p.visual === 'leads' ? 'Anfragen' : 'Tempo'}</div>
							) : (
								<img src="/images/workspace.webp" alt="" width="640" height="427" />
							)}
						</div>
					) : null}
				</div>
			</section>
		))
	}

	<CtaPhone />

	<section class="section center">
		<div class="wrap">
			<h2>Was macht uns besonders?</h2>
			<p class="intro">
				9to6 ist eine Agentur mit Sitz in Frankfurt am Main. Wir helfen Unternehmen mit Webdesign und Webentwicklung,
				online klarer aufzutreten, schneller zu laden und Anfragen zu gewinnen. Jedes Projekt bekommt eine Lösung, die
				zu Ziel, Inhalt und Budget passt.
			</p>
			<p>
				<a class="btn" href="/kontakt/">Kontakt</a>
			</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap-wide split">
			<div class="media">
				<img src="/images/boost.webp" alt="Team bei der Arbeit am Webauftritt" width="640" height="586" />
			</div>
			<div>
				<h2>Unser Ansatz für nachhaltige Websites</h2>
				<Accordion
					items={ansatz.map((a) => ({
						q: a.title,
						a: a.text,
					}))}
				/>
			</div>
		</div>
	</section>

	<section class="section center">
		<div class="wrap">
			<h2>Webdesign und Entwicklung, die zu deinem Alltag passen</h2>
			<p class="intro">
				Handwerk, Studio, Produktmarke oder interne Plattform: Wir schauen uns an, was schon da ist, und bauen das, was
				fehlt. Ohne Theme-Zwang, ohne Ballast, der Kunden ausbremst.
			</p>
			<p>
				<a class="btn" href="/leistungen/">Leistungen</a>
			</p>
		</div>
	</section>

	<section class="section" aria-labelledby="cases-heading">
		<div class="wrap">
			<h2 id="cases-heading" class="center">Websites, die im Einsatz sind</h2>
			<p class="intro center">Echte Auftritte, keine Moodboards. Mehr dazu unter Referenzen.</p>
			<div class="cards" style="margin-top:36px">
				{
					cases.map((c) => (
						<a class="card" href="/referenzen/">
							<div class="shot">
								<img class="shot-img" src={c.image} alt={c.imageAlt} width="1280" height="800" />
							</div>
							<div class="card-body">
								<div class="meta">{c.place}</div>
								<h3>{c.name}</h3>
								<p>{c.role}</p>
								<div class="pills">
									<span class="pill">{c.stack}</span>
									{c.founder ? <span class="pill">Gründerprojekt</span> : <span class="pill">Kundenprojekt</span>}
								</div>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<CtaDark />
</BaseLayout>
