---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import LeadActions from '../../components/LeadActions.astro';
import Picture from '../../components/Picture.astro';
import FaqSection from '../../components/FaqSection.astro';
import Related from '../../components/Related.astro';
import TrustProof from '../../components/TrustProof.astro';
import { productCases, serviceFaqs } from '../../data/site';
import { related } from '../../data/related';

const pillars = [
	{
		title: 'Schnelle Ladezeiten',
		text: 'Schlanker Code, optimierte Bilder in AVIF und WebP, selbst gehostete Schriften. Deine Seite lädt auch unterwegs am Handy zügig.',
	},
	{
		title: 'Technische SEO',
		text: 'Saubere Überschriften, Metadaten, strukturierte Daten, Sitemap und Weiterleitungen. Google versteht von Anfang an, worum es geht.',
	},
	{
		title: 'Sicher und wartungsarm',
		text: 'Statisches Hosting ohne angreifbare Plugins. Weniger Updates, weniger Risiko, weniger laufender Aufwand.',
	},
	{
		title: 'Formulare, die ankommen',
		text: 'Kontakt- und Buchungswege, die auf jedem Gerät funktionieren und Anfragen zuverlässig zustellen.',
	},
	{
		title: 'Datenschutz eingebaut',
		text: 'Keine Google Fonts von fremden Servern, kein unnötiges Tracking. DSGVO-freundlich ab der ersten Zeile.',
	},
	{
		title: 'Bereit zu wachsen',
		text: 'Neue Seiten, ein Blog, ein Shop oder Kundenkonten lassen sich später ergänzen, ohne neu anzufangen.',
	},
];

const steps = [
	{ title: 'Analyse', text: 'Technik, Inhalte, Tempo und Rankings der aktuellen Seite. Du erfährst, was bleibt und was neu muss.' },
	{ title: 'Planung', text: 'Seitenstruktur, Funktionen und Technik, abgestimmt auf dein Ziel und dein Budget.' },
	{ title: 'Entwicklung', text: 'Umsetzung in kurzen Schleifen mit Vorschau-Links. Du siehst den Fortschritt live.' },
	{ title: 'Launch', text: 'Weiterleitungen, Metadaten, Search Console, Hosting. Danach beobachten und nachschärfen.' },
];
---

<BaseLayout
	title="Webentwicklung Frankfurt & Rhein-Main | 9to6"
	description="Schnelle, sichere Websites und Relaunches für Unternehmen in Frankfurt und Rhein-Main. Technische SEO, kurze Ladezeiten und wenig Wartungsaufwand."
	ogImagePath="/images/ref-oberlerchner-og.jpg"
	ogImageAlt="Website von Holzbau Oberlerchner, entwickelt von 9to6"
	ogImageWidth={1200}
	ogImageHeight={750}
	schema="service"
	serviceName="Webentwicklung"
	faqs={serviceFaqs.webentwicklung}
	breadcrumbs={[
		{ name: 'Leistungen', href: '/leistungen/' },
		{ name: 'Webentwicklung', href: '/leistungen/webentwicklung/' },
	]}
>
	<section class="page-hero">
		<div class="wrap page-hero-grid">
			<div>
			<p class="eyebrow">Webentwicklung · Frankfurt und Rhein-Main</p>
			<h1>Webentwicklung, die schnell ist und bleibt.</h1>
			<p class="sub">
				Wir entwickeln Websites und Web-Anwendungen, die schnell laden, bei Google technisch sauber dastehen
				und kaum Wartung brauchen.
			</p>
			<LeadActions primaryLabel="Projekt besprechen" />
			</div>
			<div class="hero-visual hero-visual-img">
				<Picture name="mock-dev" alt="Von 9to6 entwickelte Website von Holzbau Oberlerchner auf Laptop und Smartphone" sizes="(min-width: 900px) 520px, 92vw" width={1200} height={1020} loading="eager" fetchpriority="high" />
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="technik-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Was du bekommst</p>
				<h2 id="technik-heading">Technik, die du nicht siehst, aber merkst.</h2>
				<p class="lead">
					Für dich zählt das Ergebnis: eine Seite, die schnell lädt, gefunden wird und Anfragen zustellt. Warum Tempo so
					wichtig ist, erklärt der Artikel
					<a href="/blog/core-web-vitals-und-google-ranking/">Ladezeit, Core Web Vitals und Google-Ranking</a>.
				</p>
			</div>
			<div class="feature-grid">
				{
					pillars.map((item) => (
						<article class="feature">
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="wordpress-heading">
		<div class="wrap split">
			<div>
				<p class="eyebrow">Relaunch</p>
				<h2 id="wordpress-heading">Raus aus dem langsamen WordPress.</h2>
				<p class="body">
					Viele unserer Projekte starten mit einer WordPress-Seite, die über die Jahre langsam und wartungsintensiv
					geworden ist: zu viele Plugins, ein schweres Theme, ständige Updates. Wir bauen sie schlank neu, übernehmen
					alle wichtigen Inhalte und leiten jede alte URL sauber um – damit deine Rankings den Umzug überstehen.
				</p>
				<p class="body">
					Alles zum Ablauf unter <a href="/leistungen/#relaunch">Relaunch</a>.
				</p>
			</div>
			<div class="media media-frame">
				<Picture name="visual-relaunch" alt="Grafik: alte WordPress-URLs werden per 301 auf die neue Website umgeleitet" sizes="(min-width: 900px) 560px, 92vw" width={1200} height={1020} />
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="prozess-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Prozess</p>
				<h2 id="prozess-heading">So entwickeln wir deine Website.</h2>
			</div>
			<ol class="steps">
				{
					steps.map((s, i) => (
						<li class="step">
							<span class="step-num">0{i + 1}</span>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<TrustProof
		id="produkte"
		eyebrow="Mehr als Websites"
		heading="Auch Shops, Plattformen und Schnittstellen."
		intro="Wenn deine Website zum Produkt wird, mit Kaufstrecke, Kundenkonten oder API, entwickeln wir auch das. Unsere eigenen Produkte zeigen, wie."
		items={productCases}
	/>

	<TrustProof heading="Kundenprojekte, die live sind" intro="" />

	<FaqSection items={serviceFaqs.webentwicklung} title="Fragen zur Webentwicklung" />
	<Related links={related.webentwicklung} />

	<CtaDark
		title="Deine Website soll schneller werden?"
		text="Im kostenlosen Erstgespräch schauen wir uns deine aktuelle Seite an und zeigen dir, wo es hakt."
	/>
</BaseLayout>
