---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import CtaPhone from '../../components/CtaPhone.astro';

const steps = [
	{ title: 'Analyse', text: 'Technik, Inhalt, Tempo, Wettbewerb. Du bekommst klar, was bleibt und was neu muss.' },
	{ title: 'Strategie', text: 'Seitenbaum, Stack-Wahl, Ziele. Astro oder Next.js, begründet, nicht aus Gewohnheit.' },
	{ title: 'Umsetzung', text: 'Design und Code parallel genug, dass nichts verloren geht. Reviews in kurzen Schleifen.' },
	{ title: 'Launch', text: 'Redirects, Metadaten, Formular, Hosting. Danach messen und nachschärfen.' },
];
---

<BaseLayout
	title="Webentwicklung mit Astro und Next.js | 9to6"
	description="Webentwicklung von 9to6 in Frankfurt: Astro für schnelle Auftritte, Next.js für Anwendungen. Relaunch, Performance, Cloudflare Pages."
>
	<section class="page-hero center">
		<div class="wrap">
			<h1>Webentwicklung</h1>
			<p class="sub">Starke Webpräsenz. Schnell, performant, überzeugend.</p>
			<p style="margin-top:28px"><a class="btn" href="/kontakt">Angebot anfordern</a></p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<h2 class="center">Deine Website ist der sichtbarste Mitarbeiter deines Unternehmens</h2>
			<p class="intro">
				Design, Texte, Nutzerführung und mobile Performance hängen zusammen. 9to6 baut daraus ein Werkzeug, das deine
				Arbeit sichtbar macht, statt sie zu verdecken.
			</p>
		</div>
	</section>

	<section class="section" id="astro">
		<div class="wrap-wide split">
			<div class="blob">Astro</div>
			<div>
				<h2>Komplette Webentwicklung mit Astro</h2>
				<p class="body">
					Astro rendert Seiten als HTML und lädt Skripte nur für Inseln, die Interaktion brauchen. Formulare,
					Navigation, Akkordeons: genau so viel JavaScript wie nötig. Ergebnis sind kurze Ladezeiten und Werte, die in
					den Core Web Vitals stehen. Für die meisten Unternehmenswebsites ist das der richtige Kern.
				</p>
			</div>
		</div>
	</section>

	<section class="section" id="nextjs">
		<div class="wrap-wide split reverse">
			<div>
				<h2>Next.js, wenn die Seite zur Anwendung wird</h2>
				<p class="body">
					Accounts, serverseitige Logik, Produktkataloge mit häufigen Updates, APIs. Next.js trägt das, ohne dass wir
					ein CMS in die Pflicht nehmen, das die Architektur diktiert. Wir setzen es ein, wenn Astro an Grenzen kommt,
					nicht aus Prinzip.
				</p>
			</div>
			<div class="blob">Next.js</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<h2 class="center">So laufen Projekte</h2>
			<div class="steps">
				{
					steps.map((s, i) => (
						<article>
							<p class="kicker">0{i + 1}</p>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<h2 class="center">Du bekommst Klarheit über</h2>
			<ul class="icon-list intro" style="max-width:720px;margin:24px auto 0">
				<li>das aktuelle Framework und ob ein Wechsel sich lohnt</li>
				<li>Ladezeiten und was sie den Umsatz kosten</li>
				<li>Struktur und Navigation, an denen Besucher hängen bleiben</li>
				<li>Formulare, die Anfragen wirklich zustellen</li>
				<li>Hosting auf Cloudflare Pages, ohne extra Bühne</li>
			</ul>
		</div>
	</section>

	<CtaPhone />
	<CtaDark />
</BaseLayout>
