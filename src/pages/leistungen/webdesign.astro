---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import LeadActions from '../../components/LeadActions.astro';
import Picture from '../../components/Picture.astro';
import FaqSection from '../../components/FaqSection.astro';
import Related from '../../components/Related.astro';
import TrustProof from '../../components/TrustProof.astro';
import { serviceFaqs } from '../../data/site';
import { related } from '../../data/related';

const outcomes = [
	{
		title: 'Klarer erster Eindruck',
		text: 'Im ersten Bildschirm steht, was du anbietest, für wen und wo – plus ein klarer nächster Schritt.',
	},
	{
		title: 'Texte in deiner Sprache',
		text: 'Überschriften, die deine Kunden verstehen. Keine Floskeln, kein Agentur-Denglisch, kein Platzhaltertext.',
	},
	{
		title: 'Design mit System',
		text: 'Farben, Schriften und Bausteine, die auf jeder Seite zusammenpassen und sich leicht erweitern lassen.',
	},
	{
		title: 'Mobil zuerst',
		text: 'Die meisten Besucher kommen über das Smartphone. Wir gestalten zuerst für den Daumen, dann für den Desktop.',
	},
];

const steps = [
	{ title: 'Zuhören', text: 'Wen willst du gewinnen, was soll danach passieren, was gibt es schon? Ziel vor Moodboard.' },
	{ title: 'Struktur', text: 'Seitenaufbau, Überschriften, Reihenfolge. Das Angebot steht vorn, die Geschichte danach.' },
	{ title: 'Gestaltung', text: 'Typografie, Farben, Bildsprache und Bausteine – eigenständig und auf jedem Gerät klar.' },
	{ title: 'Umsetzung', text: 'Das Design wird pixelgenau zur fertigen Website. Ohne Übergabe an Dritte, ohne Qualitätsverlust.' },
];
---

<BaseLayout
	title="Webdesign Frankfurt & Rhein-Main | 9to6"
	description="Webdesign für Unternehmen in Frankfurt, Hanau, Offenbach und dem Main-Kinzig-Kreis: Struktur, Texte und Gestaltung, die Besucher zu Kunden machen."
	ogImagePath="/images/ref-elixier-og.jpg"
	ogImageAlt="Website von D&E Elixier, Webdesign für ein Kosmetikinstitut in Frankfurt"
	ogImageWidth={1200}
	ogImageHeight={750}
	schema="service"
	serviceName="Webdesign"
	faqs={serviceFaqs.webdesign}
	breadcrumbs={[
		{ name: 'Leistungen', href: '/leistungen/' },
		{ name: 'Webdesign', href: '/leistungen/webdesign/' },
	]}
>
	<section class="page-hero">
		<div class="wrap page-hero-grid">
			<div>
			<p class="eyebrow">Webdesign · Frankfurt und Rhein-Main</p>
			<h1>Webdesign, das aus Besuchern Kunden macht.</h1>
			<p class="sub">
				Wir gestalten Websites für Handwerk, Studios und Dienstleister in Frankfurt, Hanau, Offenbach und dem
				Main-Kinzig-Kreis. Eigenständig, klar strukturiert und mit einem kurzen Weg zur Anfrage.
			</p>
			<LeadActions primaryLabel="Webdesign besprechen" />
			</div>
			<div class="hero-visual hero-visual-img">
				<Picture name="mock-design" alt="Webdesign für D&E Elixier in Frankfurt auf Laptop und Smartphone" sizes="(min-width: 900px) 520px, 92vw" width={1200} height={1020} loading="eager" fetchpriority="high" />
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="intro-heading">
		<div class="wrap split split-text">
			<div>
				<p class="eyebrow">Warum Design zählt</p>
				<h2 id="intro-heading">Deine Website ist oft der erste Kontakt mit einem Kunden.</h2>
			</div>
			<div>
				<p class="body">
					Besucher entscheiden in Sekunden, ob sie bleiben. Gutes Webdesign sorgt dafür, dass sie sofort verstehen, was du
					anbietest, dir vertrauen und wissen, wie es weitergeht. Schön allein reicht nicht – es muss funktionieren.
				</p>
				<p class="body">
					Wie das in der Praxis aussieht, zeigen <a href="/referenzen/de-elixier/">D&E Elixier</a> in
					Frankfurt-Sachsenhausen und <a href="/referenzen/holzbau-oberlerchner/">Holzbau Oberlerchner</a> in Gelnhausen.
				</p>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="ergebnis-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Was du bekommst</p>
				<h2 id="ergebnis-heading">Design, das verkauft – nicht nur gefällt.</h2>
				<p class="lead">
					Warum viele schöne Websites trotzdem keine Kunden bringen, steht im Artikel
					<a href="/blog/warum-deine-website-keine-kunden-bringt/">Warum deine Website keine Kunden bringt</a>.
				</p>
			</div>
			<div class="feature-grid feature-grid-4">
				{
					outcomes.map((item) => (
						<article class="feature">
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="prozess-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Prozess</p>
				<h2 id="prozess-heading">So entsteht dein Webdesign.</h2>
			</div>
			<ol class="steps">
				{
					steps.map((s, i) => (
						<li class="step">
							<span class="step-num">0{i + 1}</span>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section" aria-labelledby="unterschied-heading">
		<div class="wrap split split-reverse">
			<div>
				<p class="eyebrow">Der Unterschied</p>
				<h2 id="unterschied-heading">Kein Theme. Keine Übergabe-Lücke.</h2>
				<p class="body">
					Viele Agenturen kaufen eine Vorlage und färben sie um. Reine Designstudios liefern Entwürfe, die jemand anderes
					umsetzen muss – und dabei geht Qualität verloren. Bei 9to6 arbeiten Design, Text und Entwicklung in einem Team
					und einem Prozess. Was du im Entwurf freigibst, siehst du genau so auf der fertigen Seite.
				</p>
				<p class="body">
					Die technische Seite beschreibt die <a href="/leistungen/webentwicklung/">Webentwicklung</a>.
				</p>
			</div>
			<div class="media media-frame">
				<Picture name="mock-dev" alt="Fertige Website von Holzbau Oberlerchner auf Laptop und Smartphone" sizes="(min-width: 900px) 560px, 92vw" width={1200} height={1020} />
			</div>
		</div>
	</section>

	<TrustProof heading="Webdesign aus der Praxis" intro="" />

	<FaqSection items={serviceFaqs.webdesign} title="Fragen zum Webdesign" />
	<Related links={related.webdesign} />

	<CtaDark
		title="Lass uns über dein Design sprechen."
		text="Im kostenlosen Erstgespräch klären wir, wen deine Website überzeugen soll und was dafür nötig ist."
	/>
</BaseLayout>
