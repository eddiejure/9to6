---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import CtaPhone from '../../components/CtaPhone.astro';

const items = [
	{
		title: 'Webdesign',
		href: '/leistungen/webdesign/',
		text: 'Struktur, Sprache und Erscheinungsbild. Die Seite soll nach dir aussehen und zum Handeln auffordern.',
	},
	{
		title: 'Webentwicklung mit Astro',
		href: '/leistungen/webentwicklung/#astro',
		text: 'Weniger JavaScript, mehr HTML. Stark für Unternehmensseiten, die schnell und suchbar sein müssen.',
	},
	{
		title: 'Webentwicklung mit Next.js',
		href: '/leistungen/webentwicklung/#nextjs',
		text: 'Wenn aus der Website eine Anwendung wird: Accounts, Daten, Workflows, Produktlogik.',
	},
	{
		title: 'Relaunch',
		href: '/kontakt/',
		text: 'Bestehende WordPress- oder Baukasten-Seiten ablösen, Inhalte retten, Tempo und Pflege verbessern.',
	},
];
---

<BaseLayout
	title="Leistungen: Webdesign, Astro und Next.js | 9to6"
	description="Webdesign und Webentwicklung auf Astro und Next.js. 9to6 in Frankfurt plant, gestaltet und programmiert Websites, die laden und Anfragen bringen."
>
	<section class="page-hero center">
		<div class="wrap">
			<h1>Leistungen</h1>
			<p class="sub">Webdesign und Webentwicklung, gebaut für den Alltag deines Betriebs.</p>
			<p style="margin-top:28px"><a class="btn" href="/kontakt/">Angebot anfordern</a></p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<p class="intro center">
				9to6 konzentriert sich auf das, was im Browser ankommt: Design, Code, Inhalt. Marketingkanäle können später
				dazukommen. Zuerst steht eine Website, die trägt.
			</p>
			<div class="cards" style="margin-top:48px">
				{
					items.map((item) => (
						<a class="card" href={item.href}>
							<div class="card-body">
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap-wide split">
			<div>
				<p class="kicker">Ablauf</p>
				<h2>Von der ersten Seite bis zum Launch</h2>
				<p class="body">
					Analyse, Struktur, Design, Umsetzung, Feinschliff. Du siehst Zwischenschritte, keine Überraschung am Ende.
					Hosting auf Cloudflare Pages legen wir mit aus, wenn du das willst.
				</p>
			</div>
			<div class="media">
				<img src="/images/laptop.webp" alt="Laptop mit Website-Entwurf" width="640" height="427" />
			</div>
		</div>
	</section>

	<CtaPhone />
	<CtaDark />
</BaseLayout>
