---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import LeadActions from '../../components/LeadActions.astro';
import FaqSection from '../../components/FaqSection.astro';
import Picture from '../../components/Picture.astro';
import TrustProof from '../../components/TrustProof.astro';
import { processSteps, serviceFaqs, services } from '../../data/site';

const audience = [
	{
		title: 'Handwerk und lokale Betriebe',
		text: 'Du überzeugst auf der Baustelle oder vor Ort. Deine Website sollte das auch tun: klar, schnell am Handy und in der Region gut gefunden.',
	},
	{
		title: 'Studios, Praxen und Institute',
		text: 'Hier zählen Vertrauen und ein kurzer Weg zum Termin. Wir gestalten ruhig und hochwertig und machen die Buchung so einfach wie möglich.',
	},
	{
		title: 'Produktmarken und Plattformen',
		text: 'Shop, Tarife, Kundenkonten oder Schnittstellen: Wenn die Website zum Produkt wird, gehören Design und Entwicklung in einen Prozess.',
	},
];

const seo = [
	'Keyword- und Themenrecherche für deine Region und Branche',
	'Seitenplanung, die zu echten Suchanfragen passt',
	'SEO-Texte von spezialisierten Textern',
	'Strukturierte Daten und Inhalte, die KI-Assistenten wie ChatGPT verstehen und zitieren',
	'Lokale Sichtbarkeit inklusive Google-Unternehmensprofil',
];

const relaunch = [
	'Analyse der bestehenden Seite: Inhalte, Rankings, Ladezeit',
	'Übernahme und Überarbeitung aller wichtigen Inhalte',
	'301-Weiterleitungen für jede alte URL, damit Rankings erhalten bleiben',
	'Prüfung in der Google Search Console nach dem Launch',
];
---

<BaseLayout
	title="Leistungen: Webdesign, Relaunch, SEO & KI-Suche | 9to6"
	description="Webdesign, Webentwicklung, Relaunch, SEO-Texte und KI-Sichtbarkeit aus einer Hand – für Unternehmen in Gelnhausen, Frankfurt und Rhein-Main."
	schema="service"
	serviceName="Webdesign, Webentwicklung und Website-Relaunch"
	faqs={serviceFaqs.hub}
	breadcrumbs={[{ name: 'Leistungen', href: '/leistungen/' }]}
>
	<section class="page-hero">
		<div class="wrap page-hero-grid">
			<div>
			<p class="eyebrow">Leistungen</p>
			<h1>Alles für deine Website. Aus einer Hand.</h1>
			<p class="sub">
				Webdesign, Entwicklung, Relaunch, SEO-Texte und Sichtbarkeit in der KI-Suche – umgesetzt von einem Team aus
				Designern, Textern und Entwicklern, koordiniert von einem festen Ansprechpartner.
			</p>
			<LeadActions />
			</div>
			<div class="hero-visual hero-visual-img">
				<Picture name="mock-design" alt="Von 9to6 gestaltete Website von D&E Elixier auf Laptop und Smartphone" sizes="(min-width: 900px) 520px, 92vw" width={1200} height={1020} loading="eager" fetchpriority="high" />
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="angebot-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Angebot</p>
				<h2 id="angebot-heading">Vier Leistungen, ein Ziel: mehr Anfragen.</h2>
			</div>
			<div class="service-grid">
				{
					services.map((service, index) => (
						<a class="service-card" href={service.href}>
							<span class="service-num">0{index + 1}</span>
							<h3>{service.title}</h3>
							<p>{service.teaser}</p>
							<ul class="tick-list">
								{service.points.map((point) => (
									<li>{point}</li>
								))}
							</ul>
							<span class="link-arrow">Mehr erfahren</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" id="relaunch" aria-labelledby="relaunch-heading">
		<div class="wrap split">
			<div>
				<p class="eyebrow">Relaunch</p>
				<h2 id="relaunch-heading">Neue Website, ohne Rankings zu verlieren.</h2>
				<p class="body">
					Deine bestehende Seite ist langsam, veraltet oder schwer zu pflegen? Wir bauen sie neu und sorgen dafür, dass
					Inhalte, Google-Rankings und alte Links den Umzug überstehen. Viele unserer Projekte sind Relaunches von
					WordPress-Seiten. Ein Redesign kostet typischerweise 3.000 bis 6.000 Euro, auf Wunsch auch in
					<a href="/preise/">monatlichen Raten</a>.
				</p>
				<ul class="tick-list">
					{relaunch.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div class="media media-frame">
				<Picture name="visual-relaunch" alt="Grafik: alte URLs werden per 301-Weiterleitung auf die neue Website umgeleitet" sizes="(min-width: 900px) 560px, 92vw" width={1200} height={1020} />
			</div>
		</div>
	</section>

	<section class="section" id="seo" aria-labelledby="seo-heading">
		<div class="wrap split split-reverse">
			<div>
				<p class="eyebrow">SEO, Texte und KI-Sichtbarkeit</p>
				<h2 id="seo-heading">Gefunden werden – bei Google und in der KI-Suche.</h2>
				<p class="body">
					Immer mehr Kunden fragen nicht nur Google, sondern auch ChatGPT, Perplexity oder Gemini. Unsere Texter und
					SEO-Spezialisten sorgen dafür, dass deine Website in beiden Welten gefunden, verstanden und empfohlen wird.
				</p>
				<ul class="tick-list">
					{seo.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div class="media media-frame">
				<Picture name="visual-seo" alt="Grafik: Website erscheint in der Google-Suche und wird von einem KI-Assistenten empfohlen" sizes="(min-width: 900px) 560px, 92vw" width={1200} height={1020} />
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="zielgruppe-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Für wen</p>
				<h2 id="zielgruppe-heading">Für Unternehmen, die online wachsen wollen.</h2>
			</div>
			<div class="feature-grid">
				{
					audience.map((item) => (
						<article class="feature">
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="prozess-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Prozess</p>
				<h2 id="prozess-heading">Vom ersten Gespräch bis zum Launch.</h2>
				<p class="lead">Du siehst jeden Zwischenschritt. Keine große Enthüllung am Ende, keine Überraschungen.</p>
			</div>
			<ol class="steps steps-5">
				{
					processSteps.map((step, i) => (
						<li class="step">
							<span class="step-num">0{i + 1}</span>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<TrustProof heading="Ergebnisse, die du anklicken kannst" />

	<FaqSection items={serviceFaqs.hub} title="Fragen zu unseren Leistungen" />

	<CtaDark
		title="Welche Leistung passt zu deinem Projekt?"
		text="Im kostenlosen Erstgespräch klären wir, ob du Webdesign, Entwicklung, einen Relaunch oder alles zusammen brauchst."
	/>
</BaseLayout>
