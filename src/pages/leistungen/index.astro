---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaDark from '../../components/CtaDark.astro';
import CtaPhone from '../../components/CtaPhone.astro';

const items = [
	{
		title: 'Webdesign',
		href: '/leistungen/webdesign/',
		text: 'Struktur, Sprache und Erscheinungsbild. Die Seite soll nach dir aussehen und zum Handeln auffordern.',
	},
	{
		title: 'Webentwicklung',
		href: '/leistungen/webentwicklung/',
		text: 'Seiten, die schnell laden, in der Suche bestehen und Anfragen wirklich zustellen.',
	},
	{
		title: 'Conversion',
		href: '/blog/aus-besuchern-werden-anfragen/',
		text: 'Wege zur Handlung: klare Angebote, starke Formulare, messbar mehr Kundenanfragen.',
	},
	{
		title: 'Relaunch',
		href: '/kontakt/',
		text: 'Bestehende Seiten ablösen, Inhalte retten, Tempo und Anfragen verbessern.',
	},
];
---

<BaseLayout
	title="Leistungen: Webdesign und Webentwicklung | 9to6"
	description="Webdesign und Webentwicklung in Frankfurt. 9to6 plant, gestaltet und programmiert Websites, die laden, überzeugen und messbar Anfragen bringen."
	schema="service"
	serviceName="Webdesign und Webentwicklung"
	breadcrumbs={[{ name: 'Leistungen', href: '/leistungen/' }]}
>
	<section class="page-hero center">
		<div class="wrap">
			<h1>Leistungen</h1>
			<p class="sub">Webdesign und Webentwicklung, gebaut für Anfragen, Tempo und Wachstum.</p>
			<p style="margin-top:28px"><a class="btn" href="/kontakt/">Angebot anfordern</a></p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<h2 class="center">Was wir bauen</h2>
			<p class="intro center">
				9to6 konzentriert sich auf das, was im Browser ankommt und im Kalender landet: Design, Inhalt, Tempo, Formulare.
				Zuerst steht eine Website, die Kunden bringt.
			</p>
			<div class="cards" style="margin-top:48px">
				{
					items.map((item) => (
						<a class="card" href={item.href}>
							<div class="card-body">
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap-wide split">
			<div>
				<p class="kicker">Ablauf</p>
				<h2>Von der ersten Seite bis zum Launch</h2>
				<p class="body">
					Analyse, Struktur, Design, Umsetzung, Feinschliff. Du siehst Zwischenschritte, keine Überraschung am Ende.
					Hosting legen wir mit aus, wenn du das willst. Nach dem Launch messen wir Anfragen und Tempo.
				</p>
			</div>
			<div class="media">
				<img src="/images/laptop.webp" alt="Laptop mit Website-Entwurf" width="640" height="427" />
			</div>
		</div>
	</section>

	<CtaPhone />
	<CtaDark />
</BaseLayout>
