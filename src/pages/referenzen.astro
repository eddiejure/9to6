---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaDark from '../components/CtaDark.astro';
import CtaPhone from '../components/CtaPhone.astro';
import { cases } from '../data/site';
---

<BaseLayout
	title="Referenzen: Websites von 9to6"
	description="Live-Websites von 9to6: Holzbau Oberlerchner, D&E Elixier, sim.do und Simtasy. Kundenprojekte und Gründerprodukte, die du öffnen kannst."
	schema="references"
	breadcrumbs={[{ name: 'Referenzen', href: '/referenzen/' }]}
>
	<section class="page-hero center">
		<div class="wrap">
			<h1>Referenzen</h1>
			<p class="sub">Live im Netz. Keine erfundenen Cases, keine fremden Budgets.</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<p class="intro center">
				Hier stehen Projekte, die du öffnen kannst. Kundenaufträge und Gründerprodukte sind getrennt gekennzeichnet.
			</p>
		</div>
	</section>

	{
		cases.map((c, i) => (
			<section class="section" id={c.slug}>
				<article class={'wrap-wide split' + (i % 2 ? ' reverse' : '')}>
					<div class="media">
						<div class="shot">
							<a href={c.url} rel="noopener" target="_blank">
								<img class="shot-img" src={c.image} alt={c.imageAlt} width="1280" height="800" />
							</a>
						</div>
					</div>
					<div>
						<p class="kicker">{c.founder ? 'Gründerprojekt' : 'Kundenprojekt'} · {c.place}</p>
						<h2>{c.name}</h2>
						<p class="body">{c.summary}</p>
						<ul class="icon-list">
							{c.points.map((p) => (
								<li>{p}</li>
							))}
						</ul>
						<div class="pills">
							<span class="pill">{c.stack}</span>
							<span class="pill">{c.role}</span>
						</div>
						<p style="margin-top:22px">
							<a class="btn" href={c.url} rel="noopener" target="_blank">
								{c.urlLabel} öffnen
							</a>
						</p>
					</div>
				</article>
			</section>
		))
	}

	<CtaPhone />
	<CtaDark />
</BaseLayout>
