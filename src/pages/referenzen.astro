---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaDark from '../components/CtaDark.astro';
import LeadActions from '../components/LeadActions.astro';
import Picture from '../components/Picture.astro';
import Related from '../components/Related.astro';
import { cases, clientCases, productCases } from '../data/site';
import { related } from '../data/related';

const groups = [
	{
		id: 'kundenprojekte',
		kicker: 'Kundenprojekte',
		title: 'Aufträge aus Gelnhausen und Frankfurt',
		intro: 'Zwei live Seiten. Zimmerei im Main-Kinzig-Kreis, Kosmetikinstitut in Frankfurt-Sachsenhausen.',
		items: clientCases,
	},
	{
		id: 'eigene-produkte',
		kicker: 'Eigene Produkte',
		title: 'sim.do und Simtasy gehören Eddie',
		intro: 'Keine Kundenarbeit. Produktseiten, die zeigen, wie eine Strecke suchbar und kaufbar wird.',
		items: productCases,
	},
];
---

<BaseLayout
	title="Referenzen: Webdesign Frankfurt und Gelnhausen | 9to6"
	description="Zwei Kundenprojekte: Zimmerei in Gelnhausen, Kosmetikinstitut in Frankfurt. Dazu die eigenen Produkte sim.do und Simtasy."
	schema="references"
	ogImagePath="/images/ref-oberlerchner-og.jpg"
	ogImageAlt="Website von Holzbau Oberlerchner in Gelnhausen"
	ogImageWidth={1200}
	ogImageHeight={750}
	breadcrumbs={[{ name: 'Referenzen', href: '/referenzen/' }]}
>
	<section class="page-hero center refs-hero">
		<div class="refs-stage" aria-hidden="false">
			{
				cases.map((item, index) => (
					<a class={`refs-card refs-card--${index + 1}`} href={`/referenzen/${item.slug}/`}>
						<span class="refs-card-float">
							<span class="refs-card-grow">
								<span class="refs-card-media">
									<Picture
										name={item.imageName}
										alt={item.imageAlt}
										sizes="(min-width: 1000px) 320px, 70vw"
										width={1280}
										height={800}
										loading={index < 2 ? 'eager' : 'lazy'}
									/>
								</span>
								<span class="refs-card-kind">{item.kind === 'client' ? 'Kundenprojekt' : 'Eigenes Produkt'}</span>
								<span class="refs-card-name">{item.name}</span>
							</span>
						</span>
					</a>
				))
			}
		</div>
		<div class="wrap refs-hero-copy">
			<h1>Webdesign-Referenzen aus Frankfurt und Gelnhausen</h1>
			<p class="sub">Kundenaufträge und eigene Produkte, klar getrennt.</p>
			<LeadActions align="center" />
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<p class="intro center">
				Entstanden aus <a href="/leistungen/webdesign/">Webdesign</a> und
				<a href="/leistungen/webentwicklung/">Webentwicklung</a>. Der Sitz ist Gelnhausen, die Kundenbeispiele liegen
				im Main-Kinzig-Kreis und in Frankfurt.
			</p>
		</div>
	</section>

	<div class="refs-below">
		{
			groups.map((group) => (
				<section class="section" id={group.id} aria-labelledby={`${group.id}-title`}>
					<div class="wrap">
						<p class="kicker center">{group.kicker}</p>
						<h2 id={`${group.id}-title`} class="center">
							{group.title}
						</h2>
						<p class="intro center">{group.intro}</p>
					</div>
					{
						group.items.map((item, index) => (
							<article class={'wrap-wide split section' + (index % 2 ? ' reverse' : '')}>
								<div class="media">
									<div class="shot">
										<a href={`/referenzen/${item.slug}/`} aria-label={`${item.name}: Fall ansehen`}>
											<Picture
												name={item.imageName}
												alt={item.imageAlt}
												class="shot-img"
												sizes="(min-width: 900px) 560px, 92vw"
												width={1280}
												height={800}
											/>
										</a>
									</div>
								</div>
								<div>
									<p class="kicker">
										{item.kind === 'client' ? 'Kundenprojekt' : 'Eigenes Produkt'} · {item.place}
									</p>
									<h3>{item.name}</h3>
									<p class="body">{item.result}</p>
									<p style="margin-top:22px">
										<a class="btn" href={`/referenzen/${item.slug}/`}>
											Fall {item.name} ansehen
										</a>
									</p>
								</div>
							</article>
						))
					}
				</section>
			))
		}
	</div>

	<Related links={related.referenzen} />
	<CtaDark
		title="Ähnliches Vorhaben?"
		text="Im Termin oder per E-Mail ordnen wir dein Projekt ein: Design, Entwicklung oder beides. Kundenprojekte bleiben das, was für andere Betriebe live steht."
	/>
</BaseLayout>
