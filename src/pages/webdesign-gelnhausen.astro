---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaDark from '../components/CtaDark.astro';
import LeadActions from '../components/LeadActions.astro';
import Picture from '../components/Picture.astro';
import FaqSection from '../components/FaqSection.astro';
import TrustProof from '../components/TrustProof.astro';
import Testimonials from '../components/Testimonials.astro';
import RegionMap from '../components/RegionMap.astro';
import { serviceFaqs, site } from '../data/site';

const checklist = [
	'Leistung und Ort stehen in der ersten Überschrift',
	'Jede wichtige Leistung hat eine eigene Seite',
	'Der Weg zur Anfrage ist von jeder Seite aus erreichbar',
	'Die Seite lädt auch mit schwachem Netz schnell',
	'Name, Adresse und Kontakt stimmen mit dem Google-Unternehmensprofil überein',
	'Alte Adressen leiten nach einem Relaunch sauber weiter',
];

const places = [
	{ name: 'Gelnhausen', text: 'Unsere Heimat. Hier kennen wir Betriebe, Wege und Wettbewerb aus erster Hand.' },
	{ name: 'Main-Kinzig-Kreis', text: 'Von Hanau bis Schlüchtern: Handwerk und Dienstleister im ganzen Kreis.' },
	{ name: 'Hanau und Offenbach', text: 'Kurze Wege für Abstimmungen vor Ort, wenn ein Projekt es braucht.' },
	{ name: 'Frankfurt am Main', text: 'Studios, Praxen und Dienstleister, etwa D&E Elixier in Sachsenhausen.' },
];
---

<BaseLayout
	title="Webdesign Gelnhausen & Main-Kinzig-Kreis | 9to6"
	description="Webdesign-Agentur in Gelnhausen: Websites für Handwerk, Studios und Dienstleister im Main-Kinzig-Kreis, die bei Google gefunden werden und Anfragen bringen."
	schema="service"
	serviceName="Webdesign in Gelnhausen und im Main-Kinzig-Kreis"
	faqs={serviceFaqs.gelnhausen}
	ogImagePath="/images/ref-oberlerchner-og.jpg"
	ogImageAlt="Website von Holzbau Oberlerchner, Kundenprojekt in Gelnhausen"
	ogImageWidth={1200}
	ogImageHeight={750}
	breadcrumbs={[
		{ name: 'Leistungen', href: '/leistungen/' },
		{ name: 'Webdesign Gelnhausen', href: '/webdesign-gelnhausen/' },
	]}
>
	<section class="page-hero">
		<div class="wrap page-hero-grid">
			<div>
			<p class="eyebrow">Webdesign · Main-Kinzig-Kreis</p>
			<h1>Webdesign in Gelnhausen.</h1>
			<p class="sub">
				Wir kommen aus Gelnhausen und bauen Websites für Betriebe im ganzen Main-Kinzig-Kreis – damit Kunden aus der
				Umgebung dich bei Google finden und direkt anfragen.
			</p>
			<LeadActions />
			</div>
			<RegionMap />
		</div>
	</section>

	<section class="section" aria-labelledby="lokal-heading">
		<div class="wrap split">
			<div>
				<p class="eyebrow">Lokal gefunden werden</p>
				<h2 id="lokal-heading">Was eine lokale Website leisten muss.</h2>
				<p class="body">
					Wer „Zimmerei Gelnhausen“ oder „Friseur Main-Kinzig-Kreis“ sucht, will schnell eine Antwort: Wer bietet das an,
					in meiner Nähe, und wie erreiche ich ihn? Eine gute lokale Website beantwortet genau diese Fragen – für Menschen
					und für Google.
				</p>
				<ul class="tick-list">
					{checklist.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div class="media media-frame">
				<Picture
					name="mock-dev"
					alt="Website von Holzbau Oberlerchner aus Gelnhausen auf Laptop und Smartphone"
					sizes="(min-width: 900px) 560px, 92vw"
					width={1200}
					height={1020}
				/>
			</div>
		</div>
	</section>

	<TrustProof
		heading="Projekte aus der Region"
		intro="Eine Zimmerei in Gelnhausen, ein Kosmetikinstitut in Frankfurt – zwei Betriebe, ein Ziel: mehr Anfragen aus der Umgebung."
	/>

	<Testimonials />

	<section class="section" aria-labelledby="gebiet-heading">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Einzugsgebiet</p>
				<h2 id="gebiet-heading">Von Gelnhausen bis Frankfurt.</h2>
				<p class="lead">
					9to6 wurde in Gelnhausen gegründet und ist hier zu Hause. Die meisten Abstimmungen laufen per Video – wenn es
					dem Projekt hilft, kommen wir zu dir.
				</p>
			</div>
			<div class="feature-grid feature-grid-4">
				{
					places.map((place) => (
						<article class="feature">
							<h3>{place.name}</h3>
							<p>{place.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="mehr-heading">
		<div class="wrap narrow-text">
			<p class="eyebrow">Weiterlesen</p>
			<h2 id="mehr-heading">Warum manche lokalen Websites leer bleiben.</h2>
			<p class="body">
				Viele Betriebe im Main-Kinzig-Kreis haben eine Website, die fertig aussieht, aber keine Anfragen bringt. Die
				häufigsten Gründe und was du dagegen tun kannst, stehen in
				<a href="/blog/warum-deine-website-keine-kunden-bringt/">Warum deine Website keine Kunden bringt</a>. Wie Ladezeit
				deine lokale Sichtbarkeit beeinflusst, erklärt
				<a href="/blog/core-web-vitals-und-google-ranking/">Ladezeit, Core Web Vitals und Google-Ranking</a>.
			</p>
			<p class="body">
				Alle Leistungen im Überblick: <a href="/leistungen/webdesign/">Webdesign</a>,
				<a href="/leistungen/webentwicklung/">Webentwicklung</a> und <a href="/leistungen/#relaunch">Relaunch</a>.
			</p>
		</div>
	</section>

	<FaqSection items={serviceFaqs.gelnhausen} title="Fragen zu Webdesign in Gelnhausen" />
	<CtaDark
		title="Dein Betrieb soll in der Region gefunden werden?"
		text="Buch dir ein kostenloses Erstgespräch. Wir schauen uns an, wie deine Website in Gelnhausen und Umgebung dasteht."
	/>
</BaseLayout>
