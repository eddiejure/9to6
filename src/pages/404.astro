---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Seite nicht gefunden | 9to6"
	description="Diese Adresse gibt es auf 9to6.de nicht. Zurück zur Startseite, zu den Leistungen oder direkt zum Kontakt."
	schema="error"
	noindex={true}
>
	<section class="page-hero center">
		<div class="wrap">
			<h1>Seite nicht gefunden</h1>
			<p class="sub">Die Adresse führt ins Leere. Wähle einen der Wege unten.</p>
			<p class="notfound-actions">
				<a class="btn" href="/">Zur Startseite</a>
				<a class="btn btn-ghost" href="/kontakt/">Termin wählen</a>
			</p>
			<ul class="icon-list notfound-links">
				<li><a href="/leistungen/">Leistungen: Webdesign und Webentwicklung</a></li>
				<li><a href="/referenzen/">Referenzen, die du öffnen kannst</a></li>
				<li><a href="/blog/">Blog zu Conversion und Tempo</a></li>
			</ul>
		</div>
	</section>
</BaseLayout>
