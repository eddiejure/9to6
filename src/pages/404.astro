---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Seite nicht gefunden | 9to6"
	description="Diese Seite gibt es auf 9to6.de nicht (mehr). Hier geht es zur Startseite, zu den Leistungen und zum Kontakt."
	schema="error"
	noindex={true}
>
	<section class="page-hero center">
		<div class="wrap">
			<p class="eyebrow">Fehler 404</p>
			<h1>Diese Seite gibt es nicht.</h1>
			<p class="sub">Vielleicht wurde sie verschoben, oder die Adresse hat einen Tippfehler. Hier geht es weiter:</p>
			<div class="cta-row cta-row-center">
				<a class="btn btn-lg" href="/">Zur Startseite</a>
				<a class="btn btn-lg btn-ghost" href="/kontakt/">Kontakt</a>
			</div>
			<ul class="notfound-links">
				<li><a class="link-arrow" href="/leistungen/">Leistungen</a></li>
				<li><a class="link-arrow" href="/referenzen/">Referenzen</a></li>
				<li><a class="link-arrow" href="/blog/">Blog</a></li>
			</ul>
		</div>
	</section>
</BaseLayout>
